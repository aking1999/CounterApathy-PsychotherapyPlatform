@model WebApplication9.Areas.Admin.ViewModels.AdminProfileViewModel
@using Framework.Helpers.ExtensionMethods
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/year-picker/moment.min.js"></script>
<script src="~/year-picker/yearpicker.js"></script>
<link rel="stylesheet" href="~/year-picker/yearpicker.css" />

<link rel="stylesheet" href="~/country-codes-phone-input/intlTelInput.min.css" />
<link rel="stylesheet" href="~/country-codes-phone-input/demo.css" />
<script src="~/country-codes-phone-input/intlTelInput.min.js"></script>
<script id="wwwroot-utils" src="~/country-codes-phone-input/utils.js"></script>

<link rel="stylesheet" href="~/animations/trash-can/trash-can.css" />
<link rel="stylesheet" href="~/sweet-alert2/sweetalert2.min.css" />
<script src="~/sweet-alert2/sweetalert2.all.min.js"></script>
<link rel="stylesheet" href="~/css/dropdown.css" />

<style>
    .mr-06 {
        margin-right: 0.6rem !important;
    }
</style>

@await Html.TryPartialAsync("~/Views/Shared/Widgets/_NavCard.cshtml",
    new WebApplication9.WidgetViewModels.NavCardWidgetViewModel("far fa-user fa-sm",
        "text-info",
        "Hello " + Model.FirstName,
        "This is your private profile page. Only you can see this page."))

<form id="profile-form" asp-area="Admin" asp-controller="Account" asp-action="Edit" method="post" enctype="multipart/form-data" autocomplete="off">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-4 mb-xs-3 mb-sm-3 mb-md-3 mb-lg-0">
            <div class="card h-100">
                <div class="card-body no-tick">
                    <div class="account-settings">
                        <div class="user-profile pb-0">
                            <div class="user-avatar">
                                <div class="img-holder">
                                    <img src="@User.GetProfilePhotoPathOrDefaultPhotoPath(Environment)"
                                         alt="profile-photo" id="output" />
                                </div>
                            </div>
                            <h5 class="font-weight-normal text-secondary mb-3"><span id="firstname">@Model.FirstName</span> <span id="lastname">@Model.LastName</span></h5>
                        </div>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-camera fa-fw"></i></span>
                            </div>
                            <div class="custom-file">
                                <input asp-for="ProfilePhoto" class="custom-file-input">
                                <label asp-for="ProfilePhoto" class="custom-file-label">Photo</label>
                            </div>
                        </div>
                        <span>
                            <span id="validation-ProfilePhoto" asp-validation-for="ProfilePhoto" class="invalid-feedback"></span>
                            <br />
                        </span>
                        <p class="text-secondary text-center">Photo width and height should preferably be the same.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-header border-bottom-0 d-flex justify-content-between">
                    <h5 class="mb-0 text-primary fs-1">Personal info</h5>
                    <input class="dropdown" type="checkbox" id="dropdown" name="dropdown" />
                    <label class="for-dropdown btn-sm btn-soft-info mb-0 no-tick" for="dropdown"><i class="fas fa-cog mr-2"></i>Settings</label>
                    <div class="section-dropdown">
                        @if (Model.ProfilePhoto.FileName != "default-user-image.png")
                        {
                            <button class="a-drp pointer-on-hover border-0" id="btn-delete-photo">
                                <span class="trash ml-1 mr-06">
                                    <span id="span-trash"></span>
                                </span>
                                Delete photo
                            </button>
                        }
                        else
                        {
                            <button class="a-drp border-0" id="btn-to-disable" disabled title="You already do not have a profile photo.">
                                <span class="trash ml-1 mr-06">
                                    <span id="span-trash"></span>
                                </span>
                                Delete photo
                            </button>

                            <script>
                                $('#btn-to-disable').fadeTo(5, 0.5);
                            </script>
                        }
                        <a class="a-drp" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword"><i class="far fa-lock fa-fw text-primary mr-1"></i>Change password</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row gutters">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="FirstName"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-user fa-fw"></i></span>
                                    </div>
                                    <input asp-for="FirstName"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="LastName"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-user fa-fw"></i></span>
                                    </div>
                                    <input asp-for="LastName"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="LastName" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="Email"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-envelope fa-fw"></i></span>
                                    </div>
                                    <input asp-for="Email"
                                           class="form-control" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="PhoneNumber"></label>
                                <div class="input-group">
                                    <input asp-for="PhoneNumber"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="PhoneNumber" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="YearOfBirth"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-calendar fa-fw"></i></span>
                                    </div>
                                    <input asp-for="YearOfBirth"
                                           class="form-control"
                                           inputmode="numeric"
                                           oninput="this.value = this.value.replace(/\D+/g, '')"
                                           readonly />
                                </div>
                                <span>
                                    <span asp-validation-for="YearOfBirth" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="WebCredit"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">RSD</span>
                                    </div>
                                    <input asp-for="WebCredit"
                                           class="form-control"
                                           readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row gutters">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="text-right">
                                <button type="button"
                                        id="btn-submit"
                                        class="btn btn-sm btn-primary">
                                    <span id="btn-submit-text">&nbsp;Save&nbsp;</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    $(document).ready(function () {
        window.history.pushState({}, '', '@Url.Action("Profile", "Account", new { Area = "Admin" })');

        const fileExtension = ['jpeg', 'jpg', 'png'];
        let submit = $('#btn-submit');
        let submitText = $('#btn-submit-text');
        let submitTextUnchanged = submitText.html();
        let profileForm = $('#profile-form');
        let inputImage = $("#ProfilePhoto");
        let firstName = $('#FirstName');
        let lastName = $('#LastName');
        let phoneNumber = $('#PhoneNumber');
        let yearOfBirth = $("#YearOfBirth");
        let currentYear = new Date().getFullYear();

        window.intlTelInput(document.querySelector('#PhoneNumber'), {
            formatOnDisplay: true,
            separateDialCode: true,
            initialCountry: 'rs',
            nationalMode: false,
            placeholderNumberType: 'MOBILE',
            onlyCountries: ['rs'],
            utilsScript: document.getElementById('wwwroot-utils').href
        });

        yearOfBirth.yearpicker({
            year: @Model.YearOfBirth,
            startYear: currentYear - 90,
            endYear: currentYear - 18,
        });

        $('#output').click(function () {
            inputImage.click();
        });

        submit.click(function () {
            DisableInputs();
            let width = $(this).width();
            let height = $(this).height();
            submitText.fadeOut('fast', function () {
                $(this).html('<i class="fas fa-spinner fa-spin no-tick"></i>').fadeIn('slow');
                submit.width(width);
                submit.height(height);
            });

            setTimeout(function () {
                if (FormIsValid()) {
                    submitText.fadeOut('fast', function () {
                        $(this).html('<i class="ca-lightgreen fas fa-check no-tick"></i>').fadeIn('slow', function () {
                            setTimeout(function () {
                                submitText.fadeOut('fast', function () {
                                    $(this).html(submitTextUnchanged).fadeIn('slow');
                                });
                            }, 1200)

                            setTimeout(function () {
                                profileForm.submit();
                            }, 200);
                        })
                    })
                } else HandleError('Please fill all the information', '', 'info');
            }, 1200);
        });

        inputImage.on('change', function (event) {
            if (!FileExtensionValid(inputImage)) {
                inputImage.removeClass('is-valid');
                inputImage.addClass('is-invalid');
                $('#validation-ProfilePhoto').html("Allowed extensions: jpeg, jpg, png.");

                inputImage.siblings(".custom-file-label").addClass("selected").html('<i class="far fa-times text-danger mr-2"></i>Not allowed extension');
            }
            else if (inputImage.val().split("\\").pop().length) {
                inputImage.prop('readonly', true);
                inputImage.removeClass('is-invalid');
                inputImage.addClass('is-valid');
                $('#validation-ProfilePhoto').html('');

                $('.img-holder').fadeOut('fast', function () {
                    $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick" style="margin-top:42% !important;"></i>')
                        .fadeIn(800, function () {
                            $(this).fadeOut(800, function () {
                                $(this).html('<img src="" alt="profile-photo" id="output" />');
                                var image = document.getElementById("output");
                                image.src = URL.createObjectURL(event.target.files[0]);

                                $(this).fadeIn('slow');
                                inputImage.prop('readonly', false);

                                @*click listener must also be included here*@
                                $(image).click(function () {
                                    inputImage.click();
                                });
                            });
                        });
                });

                inputImage.siblings(".custom-file-label").addClass("selected").html('<i class="far fa-check text-success mr-2"></i>Image selected');
            }
        });

        function FileExtensionValid(inputImage) {
            let fileName = $(inputImage).val().split("\\").pop();
            if (fileName.length && ($.inArray($(inputImage).val().split('.').pop().toLowerCase(), fileExtension) == -1))
                return false;

            return true;
        }

        firstName.on('input', function () {
            $('#firstname').html(firstName.val());
        });

        lastName.on('input', function () {
            $('#lastname').html(lastName.val());
        });

        $('#btn-delete-photo').hover(function () {
            $('#span-trash').css({
                transform: 'rotate(-45deg)',
                transition: 'transform 250ms'
            });
        });

        $('#btn-delete-photo').mouseleave(function () {
            $('#span-trash').css({
                transform: 'rotate(0deg)',
                transition: 'transform 250ms'
            });
        });

        $('#btn-delete-photo').click(function () {
            $(this).prop('disabled', true);
            Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-sm btn-danger mr-2',
                    cancelButton: 'btn btn-sm btn-falcon-secondary'
                },
                buttonsStyling: false
            }).fire({
                title: 'Would you like to delete your profile photo?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                cancelButtonText: 'No'
            }).then((result) => {
                $('#span-trash').css({
                    transform: 'rotate(0deg)',
                    transition: 'transform 250ms'
                });
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DeleteProfilePhoto", "Account", new { Area = "Admin" })',
                        success: function (response) {
                            if (response.success === true) {
                                $('.img-holder').fadeOut('fast', function () {
                                    $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick" style="margin-top:42% !important;"></i>')
                                        .fadeIn(800, function () {
                                            $(this).fadeOut(800, function () {
                                                toastr[response.severity](response.body, response.title);
                                                $(this).html('<img src="" alt="profile-photo" id="output" />');
                                                var image = document.getElementById("output");
                                                image.src = response.path;

                                                $(this).fadeIn('slow');
                                                inputImage.prop('readonly', false);

                                                @*click listener must also be included here*@
                                                $(image).click(function () {
                                                    inputImage.click();
                                                });
                                            });

                                            $('#btn-delete-photo')
                                                .removeClass('pointer-on-hover')
                                                .attr('title', 'Nemate profilnu sliku.')
                                                .fadeTo(5, 0.5)
                                                .off('click');
                                        });
                                });
                            } else {
                                $('#btn-delete-photo').prop('disabled', false);
                                toastr[response.severity](response.body, response.title);
                            }
                        },
                        error: function (response) {
                            $('#btn-delete-photo').prop('disabled', false);
                            toastr['error']('', 'An error occurred');
                        }
                    })
                } else $('#btn-delete-photo').prop('disabled', false);
            })
        });

        function ElementIsValid(element) {
            return profileForm.validate().element($(element));
        }

        function FormIsValid() {
            const fileExtensionValid = FileExtensionValid(inputImage);
            const inputImageValid = ElementIsValid(inputImage);
            const firstNameValid = ElementIsValid(firstName);
            const lastNameValid = ElementIsValid(lastName);
            const phoneNumberValid = ElementIsValid(phoneNumber);
            const yearOfBirthValid = ElementIsValid(yearOfBirth);

            return (fileExtensionValid && inputImageValid && firstNameValid &&
                lastNameValid && phoneNumberValid &&
                yearOfBirthValid);
        }

        function EnableInputs() {
            submit.prop('disabled', false);
            firstName.prop('readonly', false);
            lastName.prop('readonly', false);
            phoneNumber.prop('readonly', false);
        }

        function DisableInputs() {
            submit.prop('disabled', true);
            firstName.prop('readonly', true);
            lastName.prop('readonly', true);
            phoneNumber.prop('readonly', true);
        }

        function HandleError(title, body, severity) {
            submitText.fadeOut('fast', function () {
                $(this).html('<i class="text-danger fas fa-times no-tick"></i>').fadeIn('slow');
                toastr[severity](body, title)
            })
            .promise()
            .done(function () {
                setTimeout(function () {
                    submitText.fadeOut('fast', function () {
                        $(this).html(submitTextUnchanged).fadeIn('slow');
                        EnableInputs();
                    });
                }, 1300)
            });
        }
    })
</script>