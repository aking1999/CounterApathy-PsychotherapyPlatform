@model WebApplication9.Areas.Therapist.ViewModels.TherapistProfileViewModel
@using Framework.Helpers
@using Framework.Helpers.ExtensionMethods
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment
@{
    ViewData.SetTitle($"{Model.FirstName} - Profil");
    ViewData.SetMetaDescription("Sa lakoćom pregledajte i ažurirajte svoje podatke.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/country-codes-phone-input/intlTelInput.min.css" />
    <link rel="stylesheet" href="~/country-codes-phone-input/demo.css" />
    <link rel="stylesheet" href="~/sweet-alert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/dropdown.css" />
    <link rel="stylesheet" href="~/multiselect/bootstrap-select.min.css" />
    <style>
        .custom-file-input:lang(sr-RS) ~ .custom-file-label::after {
            content: "Pretraži" !important;
        }

        .custom-file-input:lang(en) ~ .custom-file-label::after {
            content: "Browse" !important;
        }
    </style>
}

@await Html.TryPartialAsync("~/Views/Shared/Widgets/_NavCard.cshtml",
    new WebApplication9.WidgetViewModels.NavCardWidgetViewModel("far fa-user fa-sm",
        "text-info",
        $"Zdravo {Model.FirstName}",
        "Vaša profilna stranica. Samo Vi možete videti ovu stranicu."))

<form id="profile-form" asp-area="Therapist" asp-controller="Account" asp-action="Edit" method="post" enctype="multipart/form-data" autocomplete="off">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-12 col-lg-4 mb-xs-3 mb-sm-3 mb-md-3 mb-lg-0">
            <div class="card h-100">
                <div class="card-body no-tick">
                    <div class="account-settings">
                        <div class="user-profile pb-0">
                            <div class="user-avatar">
                                <div class="img-holder avatar">
                                    <img id="output"
                                         class="d-inline-block"
                                         src="@User.GetProfilePhotoPathOrDefaultPhotoPath(Environment)"
                                         alt="profilna slika psihoterapeuta @Model.FirstName @Model.LastName" />
                                </div>
                            </div>
                            <h5 class="font-weight-normal text-secondary mb-1">@Model.FirstName @Model.LastName</h5>
                            @if (Model.UnderSupervision)
                            {
                                <h5 class="fs-0 font-weight-normal text-500 mb-3">Psihoterapeut pod supervizijom</h5>
                            }
                            else
                            {
                                <h5 class="fs-0 font-weight-normal text-500 mb-3">Psihoterapeut</h5>
                            }
                        </div>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-camera fa-fw"></i></span>
                            </div>
                            <div class="custom-file">
                                <input asp-for="ProfilePhoto" class="custom-file-input">
                                <label asp-for="ProfilePhoto" class="custom-file-label">Profilna slika</label>
                            </div>
                        </div>
                        <span>
                            <span id="validation-ProfilePhoto" asp-validation-for="ProfilePhoto" class="invalid-feedback"></span>
                            <br />
                        </span>
                        <p class="text-secondary text-center">Dimenzije slike bi idealno trebalo da budu iste, na primer 400x400.</p>
                        <a href='@Url.PsychotherapistPublicProfileUrlWithName(Model.Id, Model.FirstName, Model.LastName)'
                           class="btn btn-block btn-soft-info mt-4">
                            <i class="far fa-user mr-2"></i>Javni profil
                        </a>
                        <a asp-area="Therapist" asp-controller="Sessions" asp-action="BookedSessions"
                           class="btn btn-block btn-soft-success mt-2">
                            <i class="far fa-calendar-check mr-2"></i>Pregledajte zakazane seanse
                        </a>
                        @if (Model.HasSetupStripeAccount)
                        {
                            <a asp-area="Therapist"
                               asp-controller="Withdrawals"
                               asp-action="StripeAccount"
                               class="btn-stripe-account btn btn-falcon-secondary btn-block mt-2">
                                <span id="btn-stripe-account-text">
                                    <img src="~/images/content-images/stripe.svg" width="46" height="22" alt="stripe logo" /> nalog
                                </span>
                            </a>
                        }
                        else
                        {
                            <a asp-area="Therapist"
                               asp-controller="Withdrawals"
                               asp-action="PaymentGatewaySetupPage"
                               class="btn-stripe-account btn btn-falcon-secondary btn-block mt-2">
                                <span id="btn-stripe-account-text">
                                    Povežite bankovni račun ( <img class="m-n2" src="~/images/content-images/stripe.svg" width="46" height="22" alt="stripe logo" /> )
                                </span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div class="card mb-3">
                <div class="card-header border-bottom-0 d-flex justify-content-between">
                    <h5 class="mb-0 text-primary fs-1">Lični podaci</h5>
                    <input id="dropdown"
                           class="dropdown"
                           type="checkbox"
                           name="dropdown" />
                    <label class="for-dropdown btn-sm btn-soft-info mb-0 no-tick noselect" for="dropdown">
                        <i class="far fa-cog mr-2"></i>Podešavanja
                    </label>
                    <div class="section-dropdown">
                        <a class="a-drp" asp-area="Therapist" asp-controller="Withdrawals" asp-action="Withdraw">
                            <i class="far fa-arrow-to-bottom fa-fw text-success mr-2"></i>Isplata sredstava
                        </a>
                        <a class="a-drp" asp-area="Therapist" asp-controller="Account" asp-action="ChangePassword">
                            <i class="fal fa-lock fa-fw text-primary mr-2"></i>Promena lozinke
                        </a>
                        <span id="btn-delete-account" class="a-drp">
                            <i class="far fa-times fa-fw text-danger mr-2"></i>Gašenje naloga
                        </span>
                    </div>
                </div>
                <div class="card-body pb-0">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="Email"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-envelope fa-fw"></i></span>
                                    </div>
                                    <input asp-for="Email"
                                           class="form-control" readonly />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="PhoneNumber"></label>
                                <div class="input-group">
                                    <input asp-for="PhoneNumber"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="PhoneNumber" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="YearOfBirth"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-calendar fa-fw"></i></span>
                                    </div>
                                    <input asp-for="YearOfBirth"
                                           class="form-control"
                                           readonly />
                                </div>
                                <span>
                                    <span asp-validation-for="YearOfBirth" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="About"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-address-card fa-fw"></i></span>
                                    </div>
                                    <textarea asp-for="About"
                                              rows="3"
                                              class="form-control">
                                    </textarea>
                                </div>
                                <span>
                                    <span asp-validation-for="About" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header border-bottom-0 d-flex justify-content-between">
                    <h5 class="mb-0 text-primary fs-1">Podaci o nalogu</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="Earnings"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">RSD</span>
                                    </div>
                                    <input asp-for="Earnings"
                                           class="form-control"
                                           readonly />
                                    <div class="input-group-append">
                                        <span class="input-group-text rounded-right" id="badge-withdraw">
                                            <a class="btn btn-mini btn-soft-success border-0">
                                                <i class="fas fa-arrow-to-bottom mr-1"></i>Isplati
                                            </a>
                                        </span>

                                        @if (Model.HasEarnings)
                                        {
                                            @Html.PartialSectionScripts(
                                            @<script>
                                                $(document).ready(function () {
                                                    $('#badge-withdraw').click(function () {
                                                        window.location.href = '@Url.Action("Withdraw", "Withdrawals", new { Area = "Therapist" })';
                                                    });
                                                })
                                            </script>)
                                        }
                                        else
                                        {
                                            @if (Model.HasSetupStripeAccount)
                                            {
                                                @Html.PartialSectionScripts(
                                                @<script>
                                                    $(document).ready(function () {
                                                        $('#badge-withdraw').click(function () {
                                                            Swal.fire(
                                                                'Nemate dovoljno sredstava za isplatu',
                                                                'Minimalna suma za isplatu je 3500 RSD i isplata se može zahtevati na svakih nedelju dana.',
                                                                'info'
                                                            );
                                                        });
                                                    });
                                                </script>)
                                                }
                                            else
                                            {
                                                @Html.PartialSectionScripts(
                                                @<script>
                                                    $(document).ready(function () {
                                                        $('#badge-withdraw').click(function () {
                                                            Swal.mixin({
                                                                customClass: {
                                                                    confirmButton: 'btn btn-sm btn-purple mr-2',
                                                                    cancelButton: 'btn btn-sm btn-falcon-secondary'
                                                                },
                                                                buttonsStyling: false
                                                            }).fire({
                                                                title: 'Da biste primali isplate, morate prvo povezati Stripe nalog sa bankovnim računom',
                                                                text: 'Kliknite na dugme ispod da biste napravili Stripe nalog i povezali ga sa bankovnim računom.',
                                                                icon: 'info',
                                                                showCancelButton: true,
                                                                confirmButtonText: 'Saznaj više',
                                                                cancelButtonText: 'Kasnije ču'
                                                            }).then((result) => {
                                                                if (result.isConfirmed) {
                                                                    window.location.href = '@Url.Action("PaymentGatewaySetupPage", "Withdrawals", new { Area = "Therapist" })'
                                                                }
                                                            })
                                                        });
                                                    })
                                                </script>)
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label asp-for="Chosen_ContactMethodsIds"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-address-book fa-fw"></i></span>
                                    </div>
                                    <select asp-for="Chosen_ContactMethodsIds"
                                            data-dropup-auto="false"
                                            class="selectpicker form-control"
                                            multiple data-live-search="true"
                                            title="Kontakt metode"
                                            data-selected-text-format="count"
                                            data-size="4">
                                        @if (Model.ToChooseFrom_ContactMethods != null && Model.ToChooseFrom_ContactMethods.Any())
                                        {
                                            foreach (var cm in Model.ToChooseFrom_ContactMethods)
                                            {
                                                var concat = Helper.GetObjectIconAndNameAndColor(cm.Text);

                                                if (cm.Selected)
                                                {
                                                    <option selected value="@cm.Value" data-content="<i class='@concat[0] fa-fw mr-2' style='color:@concat[2];'></i>@concat[1]">
                                                        @concat[1]
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@cm.Value" data-content="<i class='@concat[0] fa-fw mr-2' style='color:@concat[2];'></i>@concat[1]">
                                                        @concat[1]
                                                    </option>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <option value="" disabled>
                                                Kontakt metode nisu dostupne.
                                            </option>
                                        }
                                    </select>
                                </div>
                                <span>
                                    <span asp-validation-for="Chosen_ContactMethodsIds" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header border-bottom-0 d-flex justify-content-between">
                    <h5 class="mb-0 text-primary fs-1">Podaci o adresi</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="Street"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-road fa-fw"></i></span>
                                    </div>
                                    <input asp-for="Street"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="Street" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="HouseNumber"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-home fa-fw"></i></span>
                                    </div>
                                    <input asp-for="HouseNumber"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="HouseNumber" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="City"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-city fa-fw"></i></span>
                                    </div>
                                    <input asp-for="City"
                                           class="form-control" />
                                </div>
                                <span>
                                    <span asp-validation-for="City" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="PostalCode"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-mailbox fa-fw"></i></span>
                                    </div>
                                    <input asp-for="PostalCode"
                                           class="form-control"
                                           inputmode="numeric"
                                           oninput="this.value = this.value.replace(/\D+/g, '')" />
                                </div>
                                <span>
                                    <span asp-validation-for="PostalCode" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                <label asp-for="Country"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-globe-europe fa-fw"></i></span>
                                    </div>
                                    <input asp-for="Country"
                                           class="form-control"
                                           readonly />
                                </div>
                                <span>
                                    <span asp-validation-for="Country" class="invalid-feedback"></span>
                                    <br />
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row justify-content-end ">
                        <div class="col-12 col-sm-6">
                            <div class="text-right">
                                <button type="button"
                                        id="btn-submit"
                                        class="btn btn-sm btn-primary">
                                    <span id="btn-submit-text">&nbsp;Sačuvaj&nbsp;</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 mt-3">
            <div class="card h-100">
                <div class="card-header border-bottom-0 d-flex justify-content-between pb-0">
                    <h5 class="mb-0 text-primary fs-1"><label asp-for="PsychotherapyTechniques" class="mb-0"></label></h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-0">
                        <ul class="list-group">
                            @if (Model.PsychotherapyTechniques != null && Model.PsychotherapyTechniques.Any())
                            {
                                foreach (var technique in Model.PsychotherapyTechniques)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap border-0 px-0 pb-0">
                                        <h6 class="mb-0">
                                            <i class="@technique.Icon fa-fw mr-2" style="color: @technique.Color"></i>@technique.Name
                                        </h6>
                                        <a onclick="sessionStorage.setItem('AddTechniqueExperience', '@technique.Id')"
                                           asp-area="Therapist" asp-controller="Account" asp-action="PsychotherapyTechniquesExperiences"
                                           class="ml-auto btn btn-mini btn-soft-success rounded-pill mb-0 border-0">
                                            <i class="far fa-plus mr-1"></i>Dodajte iskustvo
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item align-items-center">
                                    <center class="mb-0 text-secondary"><i class="fal fa-times mr-2"></i>Tehnike nisu dostupne</center>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 mt-3 mb-0">
            <div class="card h-100">
                <div class="card-header border-bottom-0 d-flex justify-content-between pb-0">
                    <h5 class="mb-0 text-primary fs-1"><label asp-for="Specialities" class="mb-0"></label></h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-0">
                        <ul class="list-group">
                            @if (Model.Specialities != null && Model.Specialities.Any())
                            {
                                foreach (var specialty in Model.Specialities)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap border-0 px-0 pb-0">
                                        <h6 class="mb-0">
                                            <i class="@specialty.Icon fa-fw mr-2" style="color: @specialty.Color"></i>@specialty.Name
                                        </h6>
                                        <a onclick="sessionStorage.setItem('AddSpecialtyExperience', '@specialty.Id')"
                                           asp-area="Therapist" asp-controller="Account" asp-action="SpecialtiesExperiences"
                                           class="ml-auto btn btn-mini btn-soft-success rounded-pill mb-0 border-0">
                                            <i class="far fa-plus mr-1"></i>Dodajte iskustvo
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item align-items-center">
                                    <center class="mb-0 text-secondary"><i class="fal fa-times mr-2"></i>Specijalnosti nisu dostupne</center>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/country-codes-phone-input/intlTelInput.min.js"></script>
    <script id="wwwroot-utils" src="~/country-codes-phone-input/utils.js"></script>
    <script src="~/sweet-alert2/sweetalert2.all.min.js"></script>
    <script src="~/multiselect/bootstrap-select.min.js"></script>
    <script>
        $(document).ready(function () {
            window.history.pushState({}, '', '@Url.Action("Profile", "Account", new { Area = "Therapist" })');

            const fileExtension = ['jpeg', 'jpg', 'png'];
            let submit = $('#btn-submit');
            let submitText = $('#btn-submit-text');
            let submitTextUnchanged = submitText.html();
            let profileForm = $('#profile-form');
            let inputImage = $("#ProfilePhoto");
            let defaultUserImage = $('#output').attr('src');
            let profilePhotoAlt = $('#output').attr('alt');
            let phoneNumber = $('#PhoneNumber');
            let about = $('#About');
            let contactMethods = $('#Chosen_ContactMethodsIds');
            let street = $('#Street');
            let houseNumber = $('#HouseNumber');
            let city = $('#City');
            let postalCode = $('#PostalCode');

            window.intlTelInput(document.querySelector("#PhoneNumber"), {
                formatOnDisplay: true,
                separateDialCode: true,
                initialCountry: "rs",
                nationalMode: false,
                placeholderNumberType: "MOBILE",
                onlyCountries: ["rs"],
                utilsScript: document.getElementById("wwwroot-utils").href
            });

            $('.btn-stripe-account').click(function () {
                $(this).addClass('disabled');
                const btnText = $('#btn-stripe-account-text');
                const width = btnText.width();
                const height = btnText.height();
                btnText.fadeOut('fast', function () {
                    $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick"></i>').fadeIn('slow');
                    $(this).width(width);
                    $(this).height(height);
                })
            })

            $('#output').click(function () {
                inputImage.click();
            });

            submit.click(function () {
                DisableInputs();
                let width = $(this).width();
                let height = $(this).height();
                submitText.fadeOut('fast', function () {
                    $(this).html('<i class="fas fa-spinner fa-spin no-tick"></i>').fadeIn('slow');
                    submit.width(width);
                    submit.height(height);
                })

                setTimeout(function () {
                    if (FormIsValid()) {
                        submitText.fadeOut('fast', function () {
                            $(this).html('<i class="ca-lightgreen fas fa-check no-tick"></i>').fadeIn('slow', function () {
                                setTimeout(function () {
                                    submitText.fadeOut('fast', function () {
                                        $(this).html(submitTextUnchanged).fadeIn('slow');
                                    });
                                }, 1200)

                                setTimeout(function () {
                                    profileForm.submit();
                                }, 200);
                            })
                        })
                    } else HandleError('Popunite sva obavezna polja', '', 'info');
                }, 1200)
            });

            inputImage.on('change', function (event) {
                if (!this.files.length) {
                    inputImage.removeClass('is-valid');
                    inputImage.addClass('is-invalid');
                    inputImage.siblings(".custom-file-label").removeClass("selected").html('<i class="far fa-times text-danger mr-2"></i>Izaberite sliku.');
                    $('#validation-ProfilePhoto')
                        .removeAttr('data-valmsg-replace', 'true');

                    $('.img-holder').fadeOut('fast', function () {
                        $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick" style="margin-top:42% !important;"></i>')
                            .fadeIn(800, function () {
                                $(this).fadeOut(800, function () {
                                    $(this).html(`<img class="d-inline-block" src="${defaultUserImage}" alt="${profilePhotoAlt}" id="output" />`);
                                    var image = document.getElementById("output");

                                    $(this).fadeIn('slow');
                                    inputImage.prop('readonly', false);

                                    @* click listener must also be included here *@
                                    $(image).click(function () {
                                        inputImage.click();
                                    });
                                });
                            });
                    });
                } else {
                    if (!FileExtensionValid(inputImage)) {
                        inputImage.removeClass('is-valid');
                        inputImage.addClass('is-invalid');
                        $('#validation-ProfilePhoto')
                            .removeAttr('data-valmsg-replace')
                            .html("Dozvoljeni formati: jpeg, jpg, png.");

                        inputImage.siblings(".custom-file-label").removeClass("selected").html('<i class="far fa-times text-danger mr-2"></i>Format nedozvoljen.');

                        $('.img-holder').fadeOut('fast', function () {
                            $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick" style="margin-top:42% !important;"></i>')
                                .fadeIn(800, function () {
                                    $(this).fadeOut(800, function () {
                                        $(this).html(`<img class="d-inline-block" src="${defaultUserImage}" alt="${profilePhotoAlt}" id="output" />`);
                                        var image = document.getElementById("output");

                                        $(this).fadeIn('slow');
                                        inputImage.prop('readonly', false);

                                        @* click listener must also be included here *@
                                        $(image).click(function () {
                                            inputImage.click();
                                        });
                                    });
                                });
                        });
                    }
                    else if (inputImage.val().split("\\").pop().length) {
                        inputImage.prop('readonly', true);
                        inputImage.removeClass('is-invalid');
                        inputImage.addClass('is-valid');
                        $('#validation-ProfilePhoto').html('');

                        $('.img-holder').fadeOut('fast', function () {
                            $(this).html('<i class="text-primary fas fa-spinner fa-spin no-tick" style="margin-top:42% !important;"></i>')
                                .fadeIn(800, function () {
                                    $(this).fadeOut(800, function () {
                                        $(this).html(`<img class="d-inline-block" src="" alt="${profilePhotoAlt}" id="output" />`);
                                        var image = document.getElementById("output");
                                        image.src = URL.createObjectURL(event.target.files[0]);

                                        $(this).fadeIn('slow');
                                        inputImage.prop('readonly', false);

                                        @* click listener must also be included here *@
                                        $(image).click(function () {
                                            inputImage.click();
                                        });
                                    });
                                });
                        });

                        inputImage.siblings(".custom-file-label").addClass("selected").html('<i class="far fa-check text-success mr-2"></i>Slika izabrana');
                    }
                }
            });

            $('#btn-delete-account').click(function () {
                event.preventDefault();

                $.ajax({
                    url: '@Url.Action("DeleteAccount", "Account", new { Area = "Therapist" })',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $("input[name='__RequestVerificationToken']").val()
                    },
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.success === true) {
                            sessionStorage.setItem('requestedAccountDeletionHasEarnings', 'true');
                            window.location.href = response.therapistSupportUrl
                        }
                        else if (response.redirectUrl) window.location.href = response.redirectUrl;
                        else if (response.hasEarnings === true) {
                            Swal.mixin({
                                customClass: {
                                    confirmButton: 'btn btn-sm btn-success mr-2',
                                    cancelButton: 'btn btn-sm btn-falcon-secondary'
                                },
                                buttonsStyling: false
                            }).fire({
                                title: response.title,
                                text: response.body,
                                icon: response.severity,
                                confirmButtonText: 'Isplata sredstava',
                                showCancelButton: true,
                                cancelButtonText: 'Odustani'
                            }).then((result) => {
                                if (result.isConfirmed) window.location.href = response.withdrawUrl;
                            });
                        } else if (response.hasBookedSessions === true) {
                            Swal.mixin({
                                customClass: {
                                    confirmButton: 'btn btn-sm btn-success mr-2',
                                    cancelButton: 'btn btn-sm btn-falcon-secondary'
                                },
                                buttonsStyling: false
                            }).fire({
                                title: response.title,
                                text: response.body,
                                icon: response.severity,
                                confirmButtonText: 'Zakazane seanse',
                                showCancelButton: true,
                                cancelButtonText: 'Odustani'
                            }).then((result) => {
                                if (result.isConfirmed) window.location.href = response.allBookedSessionsUrl;
                            });
                        } else if (response.hasActiveSessions === true) {
                            Swal.mixin({
                                customClass: {
                                    confirmButton: 'btn btn-sm btn-success mr-2',
                                    cancelButton: 'btn btn-sm btn-falcon-secondary'
                                },
                                buttonsStyling: false
                            }).fire({
                                title: response.title,
                                text: response.body,
                                icon: response.severity,
                                confirmButtonText: 'Aktivne seanse',
                                showCancelButton: true,
                                cancelButtonText: 'Odustani'
                            }).then((result) => {
                                if (result.isConfirmed) window.location.href = response.allSessionsUrl;
                            });
                        } else Swal.fire(
                            response.title,
                            response.body,
                            response.severity
                        )
                    },
                    error: function () {
                        Swal.fire(
                            'Došlo je do greške',
                            'Molimo osvežite stranicu i pokušajte ponovo ili kontaktirajte podršku za terapeute.',
                            'error'
                        )
                    }
                });
            });

            function FileExtensionValid(inputImage) {
                let fileName = $(inputImage).val().split("\\").pop();
                if (fileName.length && ($.inArray($(inputImage).val().split('.').pop().toLowerCase(), fileExtension) == -1))
                    return false;

                return true;
            }

            function ContactMethodsDropdownHighlighter() {
                let contactMethodsParent = contactMethods.closest('div');

                if (contactMethods.hasClass('is-valid')) {
                    contactMethodsParent.removeClass('is-invalid');
                    contactMethodsParent.addClass('is-valid');
                }

                if (contactMethods.hasClass('is-invalid')) {
                    contactMethodsParent.removeClass('is-valid');
                    contactMethodsParent.addClass('is-invalid');
                }
            }

            contactMethods.change(function () {
                let atLeastOneSelected = false;
                $('#Chosen_ContactMethodsIds > option').each(function () {
                    if ($(this).is(':selected'))
                        atLeastOneSelected = true;
                });

                if (atLeastOneSelected) {
                    contactMethods.closest('div').removeClass('is-invalid');
                    contactMethods.closest('div').addClass('is-valid');
                }
                else {
                    contactMethods.closest('div').removeClass('is-valid');
                    contactMethods.closest('div').addClass('is-invalid');
                }
            })

            function ElementIsValid(element) {
                return profileForm.validate().element($(element));
            }

            function FormIsValid() {
                const fileExtensionValid = FileExtensionValid(inputImage);
                const inputImageValid = ElementIsValid(inputImage);
                const phoneNumberValid = ElementIsValid(phoneNumber);
                const aboutValid = ElementIsValid(about);
                const contactMethodsValid = ElementIsValid(contactMethods);
                const streetValid = ElementIsValid(street);
                const houseNumberValid = ElementIsValid(houseNumber);
                const cityValid = ElementIsValid(city);
                const postalCodeValid = ElementIsValid(postalCode);

                ContactMethodsDropdownHighlighter();

                return (fileExtensionValid && inputImageValid && phoneNumberValid &&
                    aboutValid && postalCodeValid &&
                    contactMethodsValid && streetValid &&
                    houseNumberValid && cityValid);
            }

            function EnableInputs() {
                submit.prop('disabled', false);
                phoneNumber.prop('readonly', false);
                about.prop('readonly', false);
                contactMethods.prop('readonly', false);
                street.prop('readonly', false);
                houseNumber.prop('readonly', false);
                city.prop('readonly', false);
                postalCode.prop('readonly', false);
            }

            function DisableInputs() {
                submit.prop('disabled', true);
                phoneNumber.prop('readonly', true);
                about.prop('readonly', true);
                contactMethods.prop('readonly', true);
                street.prop('readonly', true);
                houseNumber.prop('readonly', true);
                city.prop('readonly', true);
                postalCode.prop('readonly', true);
            }

            function HandleError(toastTitle, toastBody, toastSeverity) {
                submitText.fadeOut('fast', function () {
                    $(this).html('<i class="text-danger fas fa-times no-tick"></i>').fadeIn('slow');
                    toastr[toastSeverity](toastBody, toastTitle)
                })
                .promise()
                .done(function () {
                    setTimeout(function () {
                        submitText.fadeOut('fast', function () {
                            $(this).html(submitTextUnchanged).fadeIn('slow');
                            EnableInputs();
                        })
                    }, 1300)
                })
            }
        });
    </script>
}