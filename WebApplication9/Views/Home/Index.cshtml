@model DataTransferObjects.ViewModels.Shared.IndexViewModel
@using Framework.Helpers.ExtensionMethods
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor ContextAccessor
@{
    ViewData.SetTitle("Početna");
    ViewData.SetMetaDescription("CounterApathy (KontraApatija) omogućava jednostavno i efikasno povezivanje sa psihoterapeutima " +
        "različitih tehnika i specijalnosti, uz mogućnost zakazivanja besplatnih konsultacija, seansi i čitanja " +
        "recenzija koje pružaju korisne informacije pri izboru terapeuta.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="canonical" href="@Url.Action("Index", "Home", new { filter = "", predicate = "" }, ContextAccessor.HttpContext.Request.Scheme)" />
    <link rel="stylesheet" href="~/css/index.css" />
    <style>
        .btn-why-ca {
            background: #c7e0ff;
        }

        .btn-why-ca:hover {
            background: #b8d7ff;
        }

        .mt-0-15rem {
            margin-top: 0.15rem !important;
        }

        .mb-2-5rem {
            margin-bottom: 2.5rem !important;
        }
    </style>
    <link rel="stylesheet" href="~/animations/btn-send-paper-plane/btn-send-paper-plane.css" />
    @await Html.TryPartialAsync("~/Views/Shared/StructuredData/_WebSite.cshtml")
}

<section id="hero" class="d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-6 align-self-center text-center text-md-left" style="z-index: 2 !important;">
                <h1 class="text-primary mt-3 mt-md-0 fs-5 fs-md-8 no-tick font-weight-medium">CounterApathy</h1>
                <h2 class="fs-2 mt-4 mb-2-5rem">Personalizovana psihoterapija prema tvojim ciljevima.</h2>
                <a href="@Url.AllPsychotherapistsUrl()" class="btn btn-primary mb-2 mb-sm-0 mb-md-2 mb-lg-0 rounded-pill scrollto">
                    Pogledajte psihoterapeute
                </a>
                <a asp-controller="Home" asp-action="aleksa" class="btn btn-default">aleksa</a>
                <a asp-controller="Guides" asp-action="BookingRoadmap" class="btn btn-outline-success mb-2 mb-sm-0 mb-md-2 mb-lg-0 rounded-pill scrollto">
                    Lako zakažite seansu
                </a>
            </div>
            <div class="col-12 col-md-6 align-self-center">
                <div class="avatar">
                    <img src="~/custom-site-layout/images/psychotherapy-session.png" alt="psihoterapijska seansa" /> @*height="367"*@
                </div>
            </div>
        </div>
    </div>
</section>
<section class="mt-5 pt-0 pb-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-body p-4">
                        <h2 class="text-primary font-weight-normal mb-4">Zašto izabrati CounterApathy?</h2>
                        <p>
                            CounterApathy (KontraApatija) ti omogućava jednostavno povezivanje sa psihoterapeutima
                            različitih veština, uz mogućnost zakazivanja seansi, besplatnih konsultacija i čitanja
                            recenzija koje pružaju korisne informacije pri izboru terapeuta.
                        </p>
                        <p class="mb-4">
                            Odaberi CounterApathy
                            za personalizovano i bezbrižno iskustvo u pronalaženju pravog psihoterapeuta.
                        </p>
                        <div class="text-center">
                            <button id="btn-why-choose" class="btn btn-why-ca text-primary px-4 py-2 rounded-pill">
                                Saznajte više<i class="far fa-chevron-right ml-2"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="d-flex flex-column justify-content-center text-center">
                    <div class="row">
                        <div class="col-xl-4 mt-4 mt-xl-0">
                            <div class="card h-100 card-span">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="card-img-top mb-3 mb-xl-0 d-flex justify-content-center">
                                        <img class="avatar-4xl" src="~/images/content-images/medal-star-ribbon.svg" alt="slika medalje sa zvezdanom trakom" />
                                    </div>
                                    <h5 class="card-title my-xl-auto">Brzo i jednostavno</h5>
                                    <p class="card-text pt-1">
                                        Kroz 3 koraka zakažite seansu sa psihoterapeutom koji Vam odgovara
                                    </p>
                                </div>
                                <div class="card-footer pt-0">
                                    <a asp-controller="Guides" asp-action="BookingRoadmap" class="btn btn-sm btn-soft-primary rounded-pill">Saznajte kako</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 mt-3 mt-xl-0">
                            <div class="card h-100 card-span">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="card-img-top mb-3 mb-xl-0 d-flex justify-content-center">
                                        <img class="avatar-4xl" src="~/images/content-images/shield.svg" alt="slika štita" />
                                    </div>
                                    <h5 class="card-title my-xl-auto">Provereno i pouzdano</h5>
                                    <p class="card-text pt-1">
                                        Pročitajte iskustva klijenata sa željenim psihoterapeutom
                                    </p>
                                </div>
                                <div class="card-footer pt-0">
                                    <a asp-controller="Therapists" asp-action="PsychotherapistsExperiences" class="btn btn-sm btn-soft-primary rounded-pill">Pročitajte iskustva</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 mt-3 mb-4 my-xl-0">
                            <div class="card h-100 card-span">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="card-img-top mb-3 mb-xl-0 d-flex justify-content-center">
                                        <img class="avatar-4xl" src="~/images/content-images/certificate.svg" alt="slika sertifikata" />
                                    </div>
                                    <h5 class="card-title my-xl-2">Širok izbor tehnika i specijalnosti</h5>
                                    <p class="card-text pt-1">
                                        Naši psihoterapeuti raspolažu širokim spektrom tehnika i specijalnosti
                                    </p>
                                </div>
                                <div class="card-footer pt-0">
                                    <button type="button" class="btn-wide-range-techniques btn btn-sm btn-soft-primary rounded-pill">Saznajte više</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ======= Services Section ======= -->
