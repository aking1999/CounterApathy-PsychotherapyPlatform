<!-- ======= FREE CONSULTING Section ======= -->
<section id="free-consulting" class="pt-1 pb-5">
    <div class="container container-fluid">
        <div class="col-12 text-center">
            <h2 class="text-800">Besplatne konsultacije</h2>
            <p>
                <a class="fs--1" asp-controller="Consultations" asp-action="Index" target="_blank">detaljnije &gt;</a>
            </p>
            <div class="heading-underline"></div>
        </div>
        Lorem Ipsum is simply dummy text of the printing and typesetting industry.
        Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,
        when an unknown printer took a galley of type and scrambled it to make a type specimen book.
        It has survived not only five centuries, but also the leap into electronic typesetting,
        remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset
        sheets containing Lorem Ipsum passages, and more recently with desktop publishing
        software like Aldus PageMaker including versions of Lorem Ipsum.
        @if(Model.TherapistsWithConsultations != null && Model.TherapistsWithConsultations.Any())
        {
            <div class="row mt-4">
                @foreach(var therapist in Model.TherapistsWithConsultations)
                { 
                    <div class="col-6 col-sm-4 col-md-3 mb-3">
                        <div class="card h-100 card-span">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="card-img-top d-flex justify-content-start">
                                    <div class="avatar avatar-2xl mr-2">
                                        <img style="border: 2px solid white !important; min-width: 2.5rem !important;"
                                             class="rounded-circle"
                                             src="~/images/user-images/@therapist.ProfilePhotoPath"
                                             alt="Psihoterapeut @therapist.FirstName @therapist.LastName"
                                             loading="lazy" />
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <h6 class="mb-0">
                                            <a class="text-1000" href="@Url.PsychotherapistPublicProfileUrlWithName(therapist.Id, therapist.FirstName, therapist.LastName)">
                                                @therapist.FirstName @therapist.LastName
                                            </a>
                                            <i data-toggle="tooltip"
                                               data-placement="bottom"
                                               title="Psihoterapeut verifikovan"
                                               class='fas fa-badge-check text-primary ml-1 position-absolute'
                                               style="margin-top: 0.1rem !important;">
                                            </i>
                                        </h6>
                                    </div>
                                </div>
                                <button data-therapist-id="@therapist.Id"
                                        class="btn-therapist-free-consultations btn btn-sm btn-soft-primary ml-0 ml-md-0 ml-xl-5 mt-2 mt-xl-0"
                                        type="button"
                                        style="opacity: 1 !important;">
                                    <span class="btn-therapist-free-consultations-text">Besplatne konsultacije</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
<!-- End Free Consulting Section -->
<!-- ======= TECHNIQUES Section ======= -->
@if (Model.PsychotherapyTechniquesTherapists != null && Model.PsychotherapyTechniquesTherapists.Any())
{
    <section id="offered-techniques" class="pt-1 pb-5">
        <div class="container container-fluid">
            <div class="row">
                <div class="col-12">
                    <h2 class="text-center text-800">Psihoterapijske tehnike</h2>
                    <p class="text-center fs--1 text-600">@Model.PsychotherapyTechniquesCount psihoterapijskih tehnika</p>
                    <div class="heading-underline"></div>
                </div>
                @foreach (var skill in Model.PsychotherapyTechniquesTherapists)
                {
                    int i = 1;
                    var hasTherapists = false;
                    <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-3">
                        <div class="card h-100 card-span">
                            <div class="card-body pb-3 d-flex flex-column">
                                <div class="card-img-top mb-3 d-flex justify-content-start">
                                    <div class="text-center p-2 rounded-soft"
                                         data-toggle="set-color-and-background-color"
                                         data-color="@skill.Color"
                                         style="width:2.7rem!important;height:2.6rem!important;">
                                        <i class="@skill.Icon fa-fw fa-lg align-middle" style="color: @skill.Color"></i>
                                    </div>
                                </div>
                                <a href="@Url.AllPsychotherapistsUrl(skill.Filter, skill.Predicate)" class="text-1000 my-auto">
                                    <h6 class="text-wrap fs--1 mb-3">@skill.Name</h6>
                                </a>
                                <div class="d-flex flex-column">
                                    @if (skill.Therapists != null && skill.Therapists.Any())
                                    {
                                        hasTherapists = true;
                                        <p class="fs--1 mt-auto mb-1 text-muted">Psihoterapeuti</p>
                                        <div class="avatar-group">
                                            @foreach (var therapist in skill.Therapists)
                                            {
                                                <div class="avatar avatar-2xl mr-n3"
                                                data-toggle="tooltip"
                                                data-placement="bottom"
                                                data-html="true"
                                                data-title="@therapist.FirstName @therapist.LastName<i class='fas fa-badge-check text-primary ml-1'></i>"
                                                title="@therapist.FirstName @therapist.LastName<i class='fas fa-badge-check text-primary ml-1'></i>">
                                                    <img style="border: 2px solid white !important;"
                                                        class="rounded-circle"
                                                        src="~/images/user-images/@therapist.ProfilePhotoPath"
                                                        alt="profilna slika psihoterapeuta @therapist.FirstName @therapist.LastName"
                                                        loading="lazy" />
                                                </div>
                                                if (skill.Therapists.Count > 3 && i >= 3)
                                                {
                                                    <div class="mr-n3 d-inline-block">
                                                        <div class="avatar avatar-2xl">
                                                            <span style="border: 2px solid white !important;" class="avatar-name rounded-circle">
                                                                <span>+@(skill.Therapists.Count - 3)</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    break;
                                                }
                                                i++;
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="fs--1 mt-auto mb-1 text-muted">Trenutno nema psihoterapeuta.</p>
                                    }
                                </div>
                            </div>
                            <div class="card-footer border-dashed-top">
                                @if (hasTherapists)
                                {
                                    <a href="@Url.AllPsychotherapistsUrl(skill.Filter, skill.Predicate)"
                                       class="fs--1 d-flex justify-content-between align-items-center text-decoration-none text-secondary">
                                        Pogledajte sve<i class="far fa-arrow-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Apply"
                                       class="fs--1 d-flex justify-content-center align-items-center text-decoration-none text-secondary">
                                        Aplicirajte
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
