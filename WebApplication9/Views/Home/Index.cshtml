<section class="pt-1 pb-0">
    <div class="container container-fluid">
        <div class="row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-body overflow-hidden p-4 p-sm-5">
                        <img class="d-block mx-auto mb-4 avatar-4xl" src="~/custom-site-layout/images/envelope.png" alt="koverta sa zvezdicom" />
                        <h2 class="text-center h3 mb-3">Novosti</h2>
                        <p class="text-center fs--1">
                            Pretplatite se na naše novosi i budite među prvima koji će biti obavešteni
                            aktuelnim promocijama, popustima i novinama na platformi.
                        </p>
                        <form id="newsletter-join-form" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fal fa-envelope fa-fw"></i></span>
                                    </div>
                                    <input asp-for="Newsletter.Email"
                                           class="form-control mr-2"
                                           style="border-top-right-radius: 0.5rem !important; border-bottom-right-radius: 0.5rem !important;" />
                                    <span class="input-group-btn">
                                        <button id="newsletter-join" type="button" class="button">
                                            <span class="default">Pretplata</span>
                                            <span class="success text-secondary"><i class="fas fa-check text-success mr-2 no-tick"></i>Pretplaćen</span>
                                            <div class="left"></div>
                                            <div class="right"></div>
                                        </button>
                                    </span>
                                </div>
                                <span asp-validation-for="Newsletter.Email" class="invalid-feedback"></span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="py-0">
    <div class="container mt-3 mb-0">
        <hr />
        @await Html.TryPartialAsync("~/Views/Shared/FAQs/ClientAndAnonymous/_IndexFAQ.cshtml")
        <center class="pt-1">
            <a href="@Url.AllPsychotherapistsUrl()" class="btn btn-lg btn-primary rounded-pill">
                <i class="far fa-users mr-2"></i>Pogledajte psihoterapeute
            </a>
        </center>
    </div>
</section>

@section Scripts {
    @if (Model.TherapistsWithConsultations != null && Model.TherapistsWithConsultations.Any())
    {
        <script async>
            var getConsultationsUrl = '@Url.Action("GetConsultations", "Consultations", new { Area = "" })';
        </script>
        <script async src="~/js/free-consultations-setup.js"></script>
    }
    <partial name="_ValidationScriptsPartial" />
    <script async src="~/js/accordion-setup.js"></script>
    <script async>
        $(document).ready(function () {
            //$('#body-main').removeClass('pt-3');
            $('#home-section').removeClass('px-2 px-lg-0');
            $('#nav-container-main').removeClass('container mt-3');
            $('#nav-card-main').addClass('navbar-shadow').removeClass('card mb-3');
            $('#nav-cardbody-main').removeClass('card-body p-0');
            $('#container-main').removeClass('container');
            $('#container-main').addClass('px-2 px-lg-0');
            $('#footer').addClass('px-2 px-lg-0');

            $('#btn-why-choose').click(function () {
                $('html, body').animate({
                    scrollTop: $("#offered-services").offset().top
                }, 1000);
            });

            $('.btn-wide-range-techniques').click(function () {
                $('html, body').animate({
                    scrollTop: $("#offered-techniques").offset().top
                }, 1000);
            });

            $('.btn-wide-range-specialties').click(function () {
                $('html, body').animate({
                    scrollTop: $("#offered-specialties").offset().top
                }, 1000);
            });

            $('.btn-wide-range-payment-methods').click(function () {
                $('html, body').animate({
                    scrollTop: $("#offered-payment-methods").offset().top
                }, 1000);
            });
        });
    </script>
    <script async src="~/animations/gsap.min.js"></script>
    <script async>
        var newsletterSubscriptionUrl = '@Url.Action("NewsletterSubscription", "Home")';
    </script>
    <script async src="~/animations/btn-send-paper-plane/newsletter-subscription.js"></script>
}