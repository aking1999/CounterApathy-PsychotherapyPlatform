@model DataTransferObjects.ViewModels.Client.PayPalPaymentSuccessfulViewModel

@using Framework.Helpers.ExtensionMethods

@{
    ViewData.SetTitle($"Plaćanje uspešno - {Model.SecondaryCurrencyAmount} {Model.SecondaryCurrencyCode} dodato na nalog");
    ViewData.SetMetaDescription("Plaćanje uspešno, Veb kredit dodat na nalog.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/star-rating/star-rating.css" />
}

<div class="row justify-content-center text-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4 p-sm-5">
                <div id="capture">
                    <h2 class="display-1 text-300 fs-error mb-4"><img class="avatar-5xl" src="~/images/content-images/success-check-stars.png" alt="plaćanje uspešno" /></h2>
                    <h4 class="mb-4">Plaćanje uspešno</h4>
                    <h5 class="mb-4"><img src="~/images/content-images/@Model.PaymentTypeLogo" alt="@Model.PaymentType logo" /></h5>
                    <div class="col-sm-auto ml-auto d-flex align-items-center px-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless fs--1 mb-0">
                                <tbody class="text-secondary">
                                    <tr>
                                        <th class="text-left text-secondary pl-0">ID zapisa:</th>
                                        <td class="text-left text-secondary">@Model.Id</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0">ID uplate:</th>
                                        <td class="text-left text-secondary">@Model.PaymentId</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0">ID transakcije:</th>
                                        <td class="text-left text-secondary">@Model.TransactionId</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0">Ukupna uplata u @Model.PrimaryCurrencyCode:</th>
                                        <td class="text-left text-success">@Model.PrimaryCurrencyTotalPaid @Model.PrimaryCurrencyCode</td>
                                    </tr>
                                    @*<tr>
                                            <th class="text-left text-secondary pl-0">Excluding fees:</th>
                                            <td class="text-left text-success">@Model.PrimaryCurrencyAmount @Model.PrimaryCurrencyCode</td>
                                        </tr>*@
                                    <tr>
                                        <th class="text-left text-secondary pl-0">@Model.PaymentType provizija:</th>
                                        <td class="text-left text-secondary">@Model.FeePercentage %</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0">Količina provizije u @Model.PrimaryCurrencyCode:</th>
                                        <td class="text-left text-secondary">@Model.PrimaryCurrencyFeeAmount @Model.PrimaryCurrencyCode</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0">Primljeno @Model.SecondaryCurrencyCode:</th>
                                        <td class="text-left text-success">@Model.SecondaryCurrencyAmount @Model.SecondaryCurrencyCode</td>
                                    </tr>
                                    <tr>
                                        <th class="text-left text-secondary pl-0"><i class="far fa-exchange-alt fa-fw text-primary mr-2"></i>Kurs:</th>
                                        <td class="text-left text-secondary">@Model.ExchangeRate @Model.SecondaryCurrencyCode = 1 @Model.PrimaryCurrencyCode</td>
                                    </tr>
                                    @*<tr>
                                            <th class="text-left text-secondary pl-0"><i class="fal fa-calendar fa-fw text-success mr-2"></i>Request date:</th>
                                            <td class="text-left text-secondary">@Model.RequestDateTime</td>
                                        </tr>*@
                                    <tr>
                                        <th class="text-left text-secondary pl-0"><i class="fal fa-calendar fa-fw text-success mr-2"></i>Datum uplate:</th>
                                        <td class="text-left text-secondary">@Model.PaymentCompleteDateTime</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="px-0 pt-3 pb-0">
                                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                                <i class="far fa-usd-circle fa-lg mr-2"></i>
                                                <div class="text-center m-auto">
                                                    Uplaćeno <strong>@Model.SecondaryCurrencyAmount @Model.SecondaryCurrencyCode</strong>.
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <button id="btn-download-receipt" class="btn btn-link text-decoration-none mb-3">
                    <span id="btn-download-receipt-text"><i class="far fa-file-download mr-2"></i>Preuzmi račun</span>
                </button>
                <div id="buttons-holder">
                    <a id="view-all-therapists"
                       href="@Url.AllPsychotherapistsUrl()"
                       class="btn btn-info btn-lg btn-block">
                        <i class="far fa-users mr-2"></i>Pogledajte terapeute
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/html2canvas.min.js"></script>
    <script src="~/js/client/download-receipt.js"></script>
    <script>
        $(document).ready(function () {
            if (localStorage.getItem('therapist') !== null) {
                $('div#buttons-holder a').removeClass('btn-info').addClass('btn-outline-info');
                let therapist = JSON.parse(localStorage.getItem('therapist'));
                let url = '@Url.PsychotherapistPublicProfileUrlWithName("js-id", "js-thr-firstname", "js-thr-lastname")'
                    .replace('js-id', therapist.id)
                    .replace('js-thr-firstname', therapist.firstName)
                    .replace('js-thr-lastname', therapist.lastName);

                let content = `<a class="btn btn-success btn-lg btn-block book-session" href="${url}"><i class="far fa-calendar-plus mr-2"></i>Zakaži seansu sa ${therapist.firstName}</a>`
                $('#buttons-holder').prepend(content);

                function ButtonBookSessionClickEvent() {
                    window.location.href = url;
                    sessionStorage.setItem('showCalendarTab', 'true');
                }

                $('#view-all-therapists').html('<i class="far fa-users mr-2"></i>Pogledajte ostale terapeute');
                $('#view-all-therapists').click(function (event) {
                    event.preventDefault();

                    let modal = '<div id="therapist-card" data-toggle="modal" class="modal fade p-0" tabindex="-1" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true">' +
                        '<div class="modal-dialog modal-dialog-centered" role="document">' +
                        '<div class="modal-content body-color">' +
                        '<div class="modal-header border-bottom-0 pb-0">' +
                        '<h5 class="modal-title text-center mx-auto">Psihoterapeut je preporučen na osnovu Vaše dosadašnje aktivnosti</h5>' +
                        '<button type="button" class="close m-0 p-0" data-dismiss="modal" aria-label="Zatvori">' +
                        '<span aria-hidden="true">&times;</span>' +
                        '</button>' +
                        '</div>' +
                        '<div class="modal-body pb-0">' +
                        '<div class="card">' +
                        '<div class="card-body text-center">' +
                        '<div class="avatar mb-3">' +
                        `<img src="${therapist.profilePhotoPath}"` +
                        'class="rounded-circle d-inline-block"' +
                        `alt="Psihoterapeut ${therapist.firstName} ${therapist.lastName}"` +
                        'style="width:5.5rem;height:5.5rem;" />' +
                        '</div>' +
                        '<div class="row justify-content-center">' +
                        '<div>' +
                        `<h4 class="fs-0 mb-3 text-black">${therapist.firstName} ${therapist.lastName}<small class="fas fa-badge-check text-primary ml-1 no-tick" data-toggle="tooltip" data-placement="bottom" title="Psihoterapeut verifikovan" data-fa-transform="shrink-4 down-2"></small></h4>` +
                        '<div id="techniques-holder" class="mb-2"></div>' +
                        '<div id="specialties-holder"></div>' +
                        '<div id="session-price-holder"></div>' +
                        `${therapist.rating > 0 ? `<div class="rating-group mt-3 pt-1">${RenderStars(therapist.rating)}</div>` : ''}` +
                        '<div>' +
                        `<a href="${url}"` +
                        'class="btn btn-sm btn-success mt-3 border-0 book-session">' +
                        '<i class="far fa-calendar-plus mr-2"></i>Zakaži seansu' +
                        '</a> ' +
                        `<a class="btn btn-sm btn-soft-info mt-3" href="${url}" data-toggle="tooltip" data-placement="bottom" title="Profil"><i class="far fa-user"></i></a>` +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '<div class="modal-footer border-top-0 px-0">' +
                        `<a href="${$('#view-all-therapists').attr('href')}" class="w-100 mx-0 btn btn-sm btn-outline-info"><i class="far fa-users mr-2"></i>Pogledajte ostale terapeute</a>` +
                        '</div>' +
                        '</div>';

                    let createdModal = $($.parseHTML(modal));
                    let techniquesToAppend = '';
                    let specialtiesToAppend = '';

                    if (therapist.hasPsychotherapyTechnique) {
                        $.each(therapist.techniques, function (key, value) {
                            const rgb = GetRgbValue(value.color);
                            const hsl = RgbToHsl(rgb.r, rgb.g, rgb.b);
                            const hslSoft = HslToHslSoft(hsl.h, hsl.s, hsl.l);
                            const backgroundColorTemp = HslToRgb(hslSoft.h, hslSoft.s, hslSoft.l);
                            const backgroundColor = `rgb(${backgroundColorTemp.r}, ${backgroundColorTemp.g}, ${backgroundColorTemp.b})`;
                            techniquesToAppend +=
                                `<span class="fa-stack" style="width:2.2rem !important;" data-toggle="tooltip" data-placement="bottom" title="${value.name}">` +
                                `<i class="fa fa-circle fa-stack-2x" style="color:${backgroundColor} !important;"></i>` +
                                `<i class="${value.icon} fa-stack-1x" style="color:${value.color} !important;"></i>` +
                                '</span>';
                        });

                        
                    } else {
                        techniquesToAppend = '<span class="badge badge-soft-secondary"><i class="far fa-times mr-2"></i>Nema psihoterapijsku tehniku</span>';
                    }

                    if (therapist.hasSpecialty) {
                        $.each(therapist.specialties, function (key, value) {
                            const rgb = GetRgbValue(value.color);
                            const hsl = RgbToHsl(rgb.r, rgb.g, rgb.b);
                            const hslSoft = HslToHslSoft(hsl.h, hsl.s, hsl.l);
                            const backgroundColorTemp = HslToRgb(hslSoft.h, hslSoft.s, hslSoft.l);
                            const backgroundColor = `rgb(${backgroundColorTemp.r}, ${backgroundColorTemp.g}, ${backgroundColorTemp.b})`;
                            specialtiesToAppend +=
                                `<span class="fa-stack" style="width:2.2rem !important;" data-toggle="tooltip" data-placement="bottom" title="${value.name}">` +
                                `<i class="fa fa-circle fa-stack-2x" style="color:${backgroundColor} !important;"></i>` +
                                `<i class="${value.icon} fa-stack-1x" style="color:${value.color} !important;"></i>` +
                                '</span>';
                        });

                        
                    } else {
                        specialtiesToAppend = '<span class="badge badge-soft-secondary"><i class="far fa-times mr-2"></i>Nema specijalnost</span>';
                    }

                    createdModal.find('#techniques-holder').html(techniquesToAppend);
                    createdModal.find('#specialties-holder').html(specialtiesToAppend);

                    if (therapist.hasSessionPrice) {
                        createdModal.find('#session-price-holder').html(
                            '<h5 class="fs-0 font-weight-normal text-500 mt-3 mb-0">' +
                            `<span class="badge badge-pill badge-soft-success">${therapist.price}</span>` +
                            '</h5>'
                        );
                    }

                    $(createdModal).modal();

                    setTimeout(function () {
                        $('[data-toggle="tooltip"]').tooltip();
                        $('.book-session').click(ButtonBookSessionClickEvent)
                    }, 800);
                })

                $('.book-session').click(ButtonBookSessionClickEvent)
            }
        });
    </script>
}