    <div class="card h-100 card-span">
        <div class="card-body d-flex flex-column">
            <div class="card-img-top mb-3 d-flex justify-content-center">
                <div class="text-center py-5 bg-soft-success w-100 rounded-soft">
                    <i class="fal fa-calendar-check text-success fa-3x"></i>
                </div>
            </div>
            <h5 class="card-title mb-2 text-800">Kako najlakše da zakažem seansu?</h5>
