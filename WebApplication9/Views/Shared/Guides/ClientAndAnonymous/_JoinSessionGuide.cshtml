@inject Framework.Interfaces.IDateTimeHelper dateHelper

<div class="col-12 col-sm-6 col-md-4 mb-3">
    <div class="card h-100 card-span">
        <div class="card-body d-flex flex-column">
            <div class="card-img-top mb-3 d-flex justify-content-center">
                <div class="text-center py-5 bg-soft-info w-100 rounded-soft">
                    <i class="fal fa-desktop fa-3x text-black"></i><i class="fal fa-long-arrow-right fa-fw fa-3x text-black"></i><i class="ca-icon-google-meet fa-3x" style="color: #DB4437!important;"></i>
                </div>
            </div>
            <h5 class="card-title mb-2 text-800">Kako da putem računara pristupim seansi na Google Meetu?</h5>
            <p class="card-text fs--1 mb-2 mt-auto">
                Ažurirano Maj 3, 2023
            </p>
            <a class="btn btn-primary btn-block btn-sm" asp-area="" asp-controller="Guides" asp-action="JoinGoogleMeetByComputer">Detaljnije</a>
        </div>
    </div>
</div>
<div class="col-12 col-sm-6 col-md-4 mb-3">
    <div class="card h-100 card-span">
        <div class="card-body d-flex flex-column">
            <div class="card-img-top mb-3 d-flex justify-content-center">
                <div class="text-center py-5 bg-soft-info w-100 rounded-soft">
                    <i class="fal fa-mobile fa-3x text-black"></i><i class="fal fa-long-arrow-right fa-fw fa-3x text-black"></i><i class="ca-icon-google-meet fa-3x" style="color: #DB4437!important;"></i>
                </div>
            </div>
            <h5 class="card-title mb-2 text-800">Kako da putem mobilnog telefona pristupim seansi na Google Meetu?</h5>
            <p class="card-text fs--1 mb-2 mt-auto">
                Ažurirano Maj 3, 2023
            </p>
            <a class="btn btn-primary btn-block btn-sm mt-auto" asp-area="" asp-controller="Guides" asp-action="JoinGoogleMeetByPhone">Detaljnije</a>
        </div>
    </div>
</div>