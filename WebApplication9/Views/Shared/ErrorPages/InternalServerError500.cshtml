@using Framework.Helpers.ExtensionMethods
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    ViewData.SetTitle("Greška prilikom obrade zahteva");
    ViewData.SetMetaDescription("Došlo je do greške prilikom obrade Vašeg zahteva.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center text-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4 p-sm-5">
                <h2 class="display-1 text-300 fs-error mb-4"><i class="fas fa-times-circle text-danger"></i></h2>
                <h4 class="mb-3">Došlo je do greške, ali ne brinite :)</h4>
                <p>Izveštaj o grešci je poslat našem timu developera kako bi se ona ubrzo otklonila.</p>
                <hr />
                @if (User.HasSupportAvailable())
                {
                    <p>
                        <a href="@await User.GetSupportUrlAsync()">Kontaktirajte naš tim za podršku</a> ukoliko imate pitanja,
                        ideje ili povratne informacije u
                        vezi sa našim uslugama ovde na @Configuration.GetSection("Application:AppName")?.Value.
                        Rado bismo pomogli u svemu što Vam je potrebno!
                    </p>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-block">
                        <i class="fas fa-home mr-2"></i>Početna
                    </a>
                }
                else
                {
                    <div class="row">
                        <div class="col-6">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-block">
                                <i class="fas fa-home mr-2"></i>Početna
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-area="" asp-controller="Authorization" asp-action="SignIn" class="btn btn-outline-primary btn-block">
                                <i class="far fa-sign-in-alt mr-2"></i>Ulogujte se
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

