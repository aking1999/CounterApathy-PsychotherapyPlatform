    {
      "@@context" : "https://schema.org",
      "@@type" : "WebSite",
      "name" : "@Configuration.GetSection("Application:AppName")?.Value",
      "alternateName" : "@Configuration.GetSection("Application:AppNameSrb")?.Value",
      "url" : "@Configuration.GetSection("Application:AppDomain")?.Value"
    }
</script>
