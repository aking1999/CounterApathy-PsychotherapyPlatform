@using Framework.Helpers.ExtensionMethods

<ul class="navbar-nav">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            @await Html.TryPartialAsync("_NotificationsBellIcon")
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="" asp-controller="Authorization" asp-action="SignOut" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link border-0 text-dark" id="btn-sign-out">Odjava</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item border-0 border-md-right">
            <a class="nav-link btn btn-soft-primary border-0 rounded-pill py-1 mt-0 m-md-1 mr-md-2" asp-area="" asp-controller="Authorization" asp-action="SignIn">Logovanje</a>
        </li>
        <li class="nav-item border-0 border-md-left">
            <a class="nav-link text-dark pl-0 pl-md-2" asp-area="" asp-controller="Authorization" asp-action="Register">Registracija</a>
        </li>
    }
</ul>
