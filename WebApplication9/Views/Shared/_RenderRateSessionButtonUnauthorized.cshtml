@model DataTransferObjects.ViewModels.Client.BookedSessionAddRatingViewModel
@using Framework.Helpers.ExtensionMethods

<div class="d-inline-block" id="session-modal-holder-@Model.BookingId">
    @if (!Model.Rating.HasRating && Model.SessionEnded)
    {
        <div id="rate-session-modal-@Model.BookingId"
             style="z-index: 1060 !important"
             data-backdrop="static"
             data-keyboard="false"
             data-toggle="modal"
             class='modal fade p-0'
             tabindex="-1"
             role="dialog"
             aria-labelledby="ModalLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                <div class="modal-content border">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title text-center mx-auto">Ocenite ovu seansu</h5>
                        <button id="dismiss-modal-times-@Model.BookingId" type="button" class="close ml-0" onclick="$('#rate-session-modal-@Model.BookingId').modal('hide');" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <form id="form-rate-session-@Model.BookingId" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div class="modal-body pb-0">
                            <div class="row d-flex justify-content-center">
                                <div class="col-12">
                                    <div class="alert alert-info mb-0" id="privacy-protected" role="alert">
                                        <center>
                                            <i class="far fa-shield-alt mr-2"></i>Privatnost zaštićena
                                            <a href="javascript://"
                                               id="btn-show-popover-@Model.BookingId"
                                               class="col-form-label ml-2"
                                               data-toggle="popover"
                                               data-placement="bottom"
                                               title="Vaša privatnost je sve vreme zaštićena"
                                               data-content="Kada ocenite seansu, platforma garantuje da ni u kom trenutku neće Vaše lične podatke prikazati javno. Biće prikazani samo ocena, komentar i datum ocenjivanja kako bi se pomoglo narednim klijentima da donesu informisanu odluku prilikom odabira terapeuta.">
                                                <i class="fas fa-question-circle text-info"></i>
                                            </a>
                                        </center>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <center class="my-4">
                                        <div class="rating-group">
                                            <input asp-for="Rating.StarsRating" disabled checked class="rating__input rating__input--none" id="rating3-none-@Model.BookingId" value="0" type="radio">

                                            <label aria-label="1 zvezdica" class="rating__label mb-0" role="button" for="rating3-1-@Model.BookingId"><i class="rating__icon rating__icon--star fa fa-star"></i></label>
                                            <input asp-for="Rating.StarsRating" class="pointereven rating__input" id="rating3-1-@Model.BookingId" value="1" type="radio">

                                            <label aria-label="2 zvezdice" class="rating__label mb-0" role="button" for="rating3-2-@Model.BookingId"><i class="rating__icon rating__icon--star fa fa-star"></i></label>
                                            <input asp-for="Rating.StarsRating" class="rating__input" id="rating3-2-@Model.BookingId" value="2" type="radio">

                                            <label aria-label="3 zvezdice" class="rating__label mb-0" role="button" for="rating3-3-@Model.BookingId"><i class="rating__icon rating__icon--star fa fa-star"></i></label>
                                            <input asp-for="Rating.StarsRating" class="rating__input" id="rating3-3-@Model.BookingId" value="3" type="radio">

                                            <label aria-label="4 zvezdice" class="rating__label mb-0" role="button" for="rating3-4-@Model.BookingId"><i class="rating__icon rating__icon--star fa fa-star"></i></label>
                                            <input asp-for="Rating.StarsRating" class="rating__input" id="rating3-4-@Model.BookingId" value="4" type="radio">

                                            <label aria-label="5 zvezdice" class="rating__label mb-0" role="button" for="rating3-5-@Model.BookingId"><i class="rating__icon rating__icon--star fa fa-star"></i></label>
                                            <input asp-for="Rating.StarsRating" class="rating__input" id="rating3-5-@Model.BookingId" value="5" type="radio">
                                        </div>
                                        <br />
                                        <span id="validation-stars-rating-@Model.BookingId" asp-validation-for="Rating.StarsRating" class="invalid-feedback"></span>
                                    </center>

                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fal fa-comment"></i></span>
                                        </div>
                                        <textarea asp-for="Rating.Comment" id="comment-@Model.BookingId" rows="4" class="form-control"></textarea>
                                    </div>
                                    <span>
                                        <span id="validation-comment-@Model.BookingId" asp-validation-for="Rating.Comment" class="invalid-feedback"></span>
                                        <br />
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0">
                            <button type="button" id="submit-@Model.BookingId" class="btn btn-sm btn-info"><span id="submit-text-@Model.BookingId"><i class="far fa-star mr-1"></i>Oceni</span></button>
                            <button type="button" id="cancel-@Model.BookingId" class="btn btn-sm btn-falcon-secondary" onclick="$('#rate-session-modal-@Model.BookingId').modal('hide');">Zatvori</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <button id="btn-rate-session-@Model.BookingId"
                class="btn btn-soft-warning btn-mini "
                data-toggle="tooltip"
                data-placement="bottom"
                title="Ocenite ovu seansu">
            <i class="far fa-star m-0"></i>
        </button>

        @Html.PartialSectionScripts(
            @<script>
                $(document).ready(function () {
                    let rateModal = $('#rate-session-modal-' + '@Model.BookingId');
                    let modalDismissTimes = $('#dismiss-modal-times-' + '@Model.BookingId')
                    let submit = $('#submit-' + '@Model.BookingId');
                    let submitText = $('#submit-text-' + '@Model.BookingId');
                    let submitTextUnchanged = submitText.html();
                    let cancel = $('#cancel-' + '@Model.BookingId');
                    let starsRating = $('#form-rate-session-' + '@Model.BookingId' + ' input[type="radio"]');
                    let comment = $('#comment-' + '@Model.BookingId');
                    let rateForm = $('#form-rate-session-' + '@Model.BookingId');

                    $('#btn-rate-session-' + '@Model.BookingId').click(function () {
                        rateModal.modal('show');
                    });

                    submit.click(function () {
                        DisableInputs()
                        let width = submit.width();
                        let height = submit.height();
                        submitText.fadeOut('fast', function () {
                            $(this).html(`<i class="fas fa-spinner fa-spin no-tick"></i>`).fadeIn('slow');
                            submit.width(width);
                            submit.height(height);
                        })

                        setTimeout(function () {
                            if (FormIsValid()) {
                                let formData = new FormData(rateForm.get(0));
                                formData.append("bookedSessionVm.BookingId", '@Model.BookingId');
                                formData.append("bookedSessionVm.SessionId", '@Model.SessionId');
                                formData.append("bookedSessionVm.TherapistId", '@Model.TherapistId');
                                formData.append("bookedSessionVm.ClientEmail", '@Model.ClientEmail');
                                formData.append("bookedSessionVm.Rating.StarsRating", $('#form-rate-session-' + '@Model.BookingId' + ' input[type="radio"]:checked').val());
                                formData.append("bookedSessionVm.Rating.Comment", comment.val());

                                $.ajax({
                                    url: '@Url.Action("RateSessionUnauthorized", "Sessions", new { Area = "" })',
                                    type: 'POST',
                                    data: formData,
                                    processData: false,
                                    contentType: false,
                                    headers: {
                                        'RequestVerificationToken': $("input[name='__RequestVerificationToken']").val()
                                    },
                                    success: function (response) {
                                        if (response.success === true) {
                                            submitText.fadeOut('fast', function () {
                                                $(this).html('<i class="fas fa-check ca-lightgreen no-tick"></i>').fadeIn('slow', function () {
                                                    setTimeout(function () {
                                                        rateModal.modal({ backdrop: false });
                                                        rateModal.modal({ keyboard: false });
                                                        rateModal.modal('hide').remove();
                                                        $('#body-main, body').removeClass('modal-open');
                                                        $('#body-main, body').addClass('p-0');
                                                        $('.modal-backdrop').remove();
                                                        Swal.fire({
                                                            title: response.title,
                                                            text: response.body,
                                                            icon: response.severity,
                                                            confirmButtonColor: '#00d27a',
                                                            confirmButtonText: 'U redu'
                                                        }).then(() => {
                                                            $('#session-modal-holder-' + '@Model.BookingId').add($('#session-stars-holder-' + '@Model.BookingId'))
                                                                .fadeOut('slow', function () {
                                                                    $('#session-stars-holder-' + '@Model.BookingId')
                                                                        .html(RenderStars(response.starsValue));
                                                                    $('#session-modal-holder-' + '@Model.BookingId').remove();
                                                                    $('#session-stars-holder-' + '@Model.BookingId')
                                                                        .fadeIn('slow');
                                                                })
                                                        });
                                                    }, 800)
                                                })
                                            })
                                        } else {
                                            if (response.redirectUrl) window.location.href = response.redirectUrl;
                                            else HandleError(response.title, response.body, response.severity);
                                        }
                                    },
                                    error: function () {
                                        HandleError('Došlo je do greške', 'Molimo osvežite stranicu i pokušajte ponovo ili kontaktirajte korisničku podršku.', 'error');
                                    }
                                });
                            } else {
                                HandleError('Popunite sva obavezna polja', null, 'info');
                            }
                        }, 1200)
                    })

                    starsRating.change(function () {
                        if ($('#form-rate-session-' + '@Model.BookingId' + ' input[type="radio"]:checked').val() <= 3)
                            Swal.fire(
                                'Molimo unesite detaljan propratni komentar',
                                'Ocene od tri zvezdice i niže, moraju imati jasan propratni komentar ' +
                                'koji detaljno opisuje šta je dovelo do toga da klijent da nisku ocenu. ' +
                                'Odnosno šta je u toku seanse klijentu odgovaralo, a šta nije.',
                                'info'
                            );
                    });

                    function ElementIsValid(element) {
                        return rateForm.validate().element($(element));
                    }

                    function FormIsValid() {
                        const ratingValid = ElementIsValid(starsRating);
                        const commentValid = ElementIsValid(comment);

                        return (ratingValid && commentValid);
                    }

                    function DisableInputs() {
                        submit.prop('disabled', true);
                        cancel.prop('disabled', true);
                        comment.prop('readonly', true);
                        modalDismissTimes.prop('disabled', true);
                    }

                    function EnableInputs() {
                        submit.prop('disabled', false);
                        cancel.prop('disabled', false);
                        comment.prop('readonly', false);
                        modalDismissTimes.prop('disabled', false);
                    }

                    function HandleError(toastTitle, toastBody, toastSeverity) {
                        submitText.fadeOut('fast', function () {
                            $(this).html('<i class="text-danger fas fa-times no-tick"></i>').fadeIn('slow');
                            toastr[toastSeverity](toastBody, toastTitle)
                        })
                            .promise()
                            .done(function () {
                                setTimeout(function () {
                                    submitText.fadeOut('fast', function () {
                                        $(this).html(submitTextUnchanged).fadeIn('slow');
                                        EnableInputs()
                                    })
                                }, 1300)
                            });
                    }
                });
             </script>)
    }
    else
    {
        <button id="btn-rate-session-@Model.BookingId"
                class="btn btn-soft-warning btn-mini"
                data-toggle="tooltip"
                data-placement="bottom"
                title="Ocenite ovu seansu">
            <i class="far fa-star m-0"></i>
        </button>

        @Html.PartialSectionScripts(
            @<script>
                $('#btn-rate-session-' + '@Model.BookingId').click(function () {
                    Swal.fire(
                        'Seansa još uvek ne može biti ocenjena',
                        'Seansu možete oceniti nakon njenog završetka.',
                        'info'
                    );
                });
            </script>)
    }
</div>