@model DataTransferObjects.ViewModels.Client.ForgotPasswordViewModel
@using Framework.Helpers.ExtensionMethods
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData.SetTitle("Zaboravljena lozinka");
    ViewData.SetMetaDescription("Resetujte zaboravljenu lozinku putem imejla.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/animations/btn-send-paper-plane/btn-send-paper-plane.css" />
}

<div class="row flex-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <h1 class="mb-3 text-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none" target="_blank">
                @Configuration.GetSection("Application:AppName")?.Value
            </a>
        </h1>
        <div class="card">
            <div class="card-body p-4 p-sm-5">
                <img class="d-block mx-auto mb-4 avatar-4xl" src="~/custom-site-layout/images/reset-password.svg" alt="katanac sa ključem" />
                <h4 class="mb-3 text-center text-primary">Zaboravili ste lozinku?</h4>
                <p class="text-center">Unesite svoju imejl adresu i poslaćemo Vam imejl sa linkom za resetovanje vaše lozinke.</p>
                <form id="forgot-password-form" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-envelope fa-fw"></i></span>
                            </div>
                            <input asp-for="Email"
                                   class="form-control mr-2"
                                   style="border-top-right-radius: 0.5rem !important; border-bottom-right-radius: 0.5rem !important;" />
                            <span class="input-group-btn">
                                <button type="button" class="button">
                                    <span class="default">Pošalji imejl</span>
                                    <span class="success text-secondary"><i class="fas fa-check text-success mr-2 no-tick"></i>Poslato</span>
                                    <div class="left"></div>
                                    <div class="right"></div>
                                </button>
                            </span>
                        </div>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>
                </form>
                <p class="text-center mb-0">
                    <small>
                        <i class="far fa-info-circle text-info mr-2"></i>Nakon što kliknete na dugme "Pošalji imejl", otvorite imejl koji smo Vam poslali i kliknite na link u njemu. Ukoliko ne vidite imejl u Vašem inboksu, proverite spam folder.
                    </small>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/animations/btn-send-paper-plane/gsap.min.js"></script>
    <script>
        var sendPasswordResetLinkUrl = '@Url.Action("SendPasswordResetLink", "Authorization")';
    </script>
    <script src="~/animations/btn-send-paper-plane/send-password-reset-link.js"></script>
}