@model string
@using Framework.Helpers.ExtensionMethods

@{
    ViewData.SetTitle("Potvrda imejla");
    ViewData.SetMetaDescription("Potvrdite imejl kako biste otključali sve mogućnosti koje pruža CounterApathy.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/animations/btn-send-paper-plane/btn-send-paper-plane.css" />
}

<div class="row justify-content-center text-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <h1 class="mb-3 text-primary">CounterApathy</h1>
        <div class="card">
            @Html.AntiForgeryToken()
            <div class="card-body overflow-hidden p-4 p-sm-5">
                <img class="d-block mx-auto mb-4 avatar-4xl" src="~/custom-site-layout/images/mailbox.png" alt="imejl sanduče" />
                <h4 class="mb-3 text-primary">Neophodna je potvrda imejla</h4>
                <p>Molimo kliknite na dugme ispod kako bi Vam bio poslat imejl sa linkom za potvrdu na adresu <strong>@Model</strong>.</p>
                <center class="mb-3">
                    <button class="button">
                        <span class="default">Pošalji imejl</span>
                        <span class="success text-secondary"><i class="fas fa-check text-success mr-2 no-tick"></i>Poslato</span>
                        <div class="left"></div>
                        <div class="right"></div>
                    </button>
                </center>
                <small>
                    <i class="far fa-info-circle text-info mr-2"></i>Nakon što kliknete na dugme "Pošalji imejl", otvorite imejl koji smo Vam poslali i kliknite na link u njemu. Ukoliko ne vidite imejl u Vašem inboksu, proverite spam folder.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/animations/btn-send-paper-plane/gsap.min.js"></script>
    <script>
        var sendEmailConfirmationLinkUrl = '@Url.Action("SendEmailConfirmationLink", "Authorization")';
    </script>
    <script src="~/animations/btn-send-paper-plane/send-email-confirmation-link.js"></script>
}