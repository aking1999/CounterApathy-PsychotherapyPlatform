@model WebApplication9.ViewModels.TherapistPublicProfileForAnonymousVisitorViewModel
@using Framework.Helpers.ExtensionMethods
@inject Framework.Interfaces.IDateTimeHelper dateHelper
@{
    ViewData.SetTitle(!Model.UnderSupervision ? $"Psihoterapeut {Model.FirstName} {Model.LastName}" : $"Psihoterapeut pod supervizijom - {Model.FirstName} {Model.LastName}");
    ViewData.SetMetaDescription(!Model.UnderSupervision ?
        $"Licencirani psihoterapeut - {Model.FirstName} {Model.LastName} - {string.Join(" · ", Model.PsychotherapyTechniquesExperiences.Select(tech => tech.Name))} · " +
        $"{string.Join(" · ", Model.SpecialtiesExperiences.Select(tech => tech.Name))}" :
        $"Psihoterapeut pod supervizijom - {Model.FirstName} {Model.LastName} - {string.Join(" · ", Model.PsychotherapyTechniquesExperiences.Select(tech => tech.Name))} · " +
        $"{string.Join(" · ", Model.SpecialtiesExperiences.Select(tech => tech.Name))}");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/star-rating/star-rating.css" />
    <style>
        /*.modal-backdrop:nth-child(2n-1) {
            display: none;
        }*/
        .swal2-footer {
            margin: 0.3em 0 0 !important;
        }

        @@media all and (max-width:1024px) {
            .btn-lg-block {
                width: 100%;
                display: block;
            }
        }
    </style>
    <link rel="stylesheet" href="~/evocalendar/evo-calendar.css" />
    <link rel="stylesheet" href="~/evocalendar/evo-calendar.royal-navy.min.css" />
    <script src="~/evocalendar/evo-calendar.js"></script>
    <link rel="stylesheet" href="~/country-codes-phone-input/intlTelInput.min.css" />
    <link rel="stylesheet" href="~/country-codes-phone-input/demo.css" />
    <link rel="stylesheet" href="~/sweet-alert2/sweetalert2.min.css" />
    <script async src="~/sweet-alert2/sweetalert2.min.js"></script>
    <script async src="~/sweet-alert2/sweetalert2.all.min.js"></script>
    <link rel="stylesheet" href="~/multiselect/bootstrap-select.min.css" />
    <script async src="~/multiselect/bootstrap-select.min.js"></script>
    <script src="~/country-codes-phone-input/intlTelInput.min.js"></script>
    <script id="wwwroot-utils" src="~/country-codes-phone-input/utils.js"></script>
}

<div class="card mb-3">
    <div class="card-header position-relative min-vh-25 mb-7">
        <div class="bg-holder rounded-soft rounded-bottom-0" style="background-image: url(/images/content-images/public-profile-cover-photo.png);">
        </div>
        <div class="avatar avatar-5xl avatar-profile">
            <img class="rounded-circle img-thumbnail shadow-sm" src="@Model.ProfilePhoto"
                 alt="Psihoterapeut @Model.FirstName @Model.LastName"
                 loading="lazy" />
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8 d-flex flex-column">
                <h4 class="mb-3 text-black">
                    <span id="therapist-first-name">@Model.FirstName</span> <span id="therapist-last-name">@Model.LastName</span><small class="fas fa-badge-check text-primary ml-1 no-tick" data-toggle="tooltip" data-placement="bottom" title="Psihoterapeut verifikovan" data-fa-transform="shrink-4 down-2"></small>
                </h4>
                @if (Model.UnderSupervision)
                {
                    <h5 class="fs-0 font-weight-normal text-500"><i class="fal fa-minus fa-fw mr-2 no-tick"></i>Psihoterapeut pod supervizijom</h5>
                }
                else
                {
                    <h5 class="fs-0 font-weight-normal text-500"><i class="fal fa-minus fa-fw mr-2 no-tick"></i>Psihoterapeut</h5>
                }
                <h5 class="fs-0 font-weight-normal text-500"><i class="@Model.Gender.Icon fa-fw @Model.Gender.ColorClass mr-2 no-tick"></i>@Model.Gender.Name</h5>
                <h5 class="fs-0 font-weight-normal text-500 mb-3"><i class="fal fa-location-circle text-primary fa-fw mr-2 no-tick"></i>@Model.City, @Model.Country</h5>
                @if (!string.IsNullOrWhiteSpace(Model.SessionPrice))
                {
                    <h5 class="fs-0 font-weight-normal text-500 mb-3 has-session-price">
                        <span id="price-range" class="badge badge-pill badge-soft-success">@Model.SessionPrice</span>
                    </h5>
                }
                else
                {
                    <h5 class="fs-0 font-weight-normal text-500 mb-3 has-session-price">
                        <span id="price-range" class="badge badge-pill badge-soft-warning">Trenutno nema seanse</span>
                    </h5>
                }
                @if (Model.Rating > 0)
                {
                    <h5 class="fs-0 font-weight-normal text-500 mb-3">
                        @await Html.TryPartialAsync("_RenderStars", Model.Rating)
                    </h5>
                }
                <div class="mt-auto">
                    <button id="main-btn-book-session"
                            class="btn btn-sm btn-success"
                            type="button">
                        <i class="far fa-calendar-plus mr-2"></i>Zakaži seansu
                    </button>
                    @if (Model.HasUpcomingConsultation)
                    { 
                        <button data-therapist-id="@Model.TherapistAccountId"
                                class="btn-therapist-free-consultations btn btn-sm btn-soft-primary"
                                type="button"
                                style="opacity: 1 !important;">
                            <span class="btn-therapist-free-consultations-text">Besplatne konsultacije</span>
                        </button>
                    }
                </div>
                <div class="border-dotted-bottom-4 my-4 d-lg-none"></div>
            </div>
            <div class="col mt-0 mt-lg-5">
                @if (Model.PsychotherapyTechniquesExperiences != null && Model.PsychotherapyTechniquesExperiences.Any())
                {
                    foreach (var technique in Model.PsychotherapyTechniquesExperiences)
                    {
                        <div class="media align-items-center mb-2">
                            <i class="@technique.Icon fa-fw mr-2 no-tick" style="color: @technique.Color"></i>
                            <div class="media-body">
                                <h6 class="mb-0">@technique.Name</h6>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="media align-items-center mb-2">
                        <i class="far fa-times mr-2 text-700"></i>
                        <div class="media-body">
                            <h6 class="mb-0">Nema psihoterapijsku tehniku</h6>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row">
