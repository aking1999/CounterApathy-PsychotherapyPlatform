@section Scripts {
    @*If SessionPrice exists, it means the user has sessions, which means we will render
    countdown how much time the user has to finish the payment,
    so we need to include stripe.js, moment.js libraries*@
    @if (!string.IsNullOrWhiteSpace(Model.SessionPrice))
    {
        <partial name="_ValidationScriptsPartial" />
        <script async src="https://js.stripe.com/v3/"></script>
        <script src="~/year-picker/moment.min.js"></script>
    }
    @if (Model.HasUpcomingConsultation)
    {
        <script async>
            var getConsultationsUrl = '@Url.Action("GetConsultations", "Consultations", new { Area = "" })';
        </script>
        <script async src="~/js/free-consultations-setup.js"></script>
    }
    <script async src="~/js/accordion-setup.js"></script>
    <script async>
        $(document).ready(function () {
            let therapist = {
                id: '@Model.TherapistAccountId',
                profilePhotoPath: '@Model.ProfilePhoto',
                firstName: $('#therapist-first-name').html(),
                lastName: $('#therapist-last-name').html(),
                techniques: [],
                specialties: [],
                price: $('#price-range').text(),
                rating: @Model.Rating,
                hasPsychotherapyTechnique: !$('.no-psychotherapy-technique').length,
                hasSpecialty: !$('.no-specialty').length,
                hasSessionPrice: $('.has-session-price').length
            };

            if (therapist.hasPsychotherapyTechnique) {
                $('.therapist-psychotherapy-technique').each(function () {
                    let techName = $(this).find('.psychotherapy-technique-name').text().trim();
                    let techColor = $(this).find('[data-icon]').css('color');
                    let techIcon = $(this).find('[data-icon]').attr('data-icon');
                    therapist.techniques.push(new TherapistSkill(techName, techColor, techIcon));
                })
            }

            if (therapist.hasSpecialty) {
                $('.therapist-specialty').each(function () {
                    let specName = $(this).find('.specialty-name').text().trim();
                    let specColor = $(this).find('[data-icon]').css('color');
                    let specIcon = $(this).find('[data-icon]').attr('data-icon');
                    therapist.specialties.push(new TherapistSkill(specName, specColor, specIcon));
                })
            }

            localStorage.setItem('therapist', JSON.stringify(therapist));

            function ShowCalendarTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-sessions-tab').addClass('active');
                $('#pill-tab-sessions').addClass('show active');

                $('html, body').animate({
                    scrollTop: $("#pill-tab-sessions").offset().top
                }, 2000);
            };

            function ShowSkillsTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-skills-tab').addClass('active');
                $('#pill-tab-skills').addClass('show active');

                $('html, body').animate({
                    scrollTop: $('#pill-tab-skills').offset().top
                }, 1000)
            }

            function ShowReviewsTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-reviews-tab').addClass('active');
                $('#pill-tab-reviews').addClass('show active');

                $('html, body').animate({
                    scrollTop: $('#pill-tab-reviews').offset().top
                }, 1000)
            }

            if (sessionStorage.getItem('showCalendarTab') === 'true') {
                sessionStorage.removeItem('showCalendarTab');
                ShowCalendarTab();
            }

            if (sessionStorage.getItem('showSkillsTab') === 'true') {
                sessionStorage.removeItem('showSkillsTab');
                ShowSkillsTab();
            }

            $('#main-btn-book-session').click(function () {
                ShowCalendarTab();
            });
        });
    </script>
}

