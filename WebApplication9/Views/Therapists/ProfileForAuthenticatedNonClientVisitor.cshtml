                                        <div class="media">
                                            <i data-icon="@technique.Icon" class="@technique.Icon fa-fw fa-2x no-tick" style="color: @technique.Color"></i>
                                            <div class="media-body position-relative pl-3">
                                                <h6 class="text-1000 fs-0 mb-0 pb-1">
                                                    @technique.Name
                                                    <small class="fas fa-check-circle text-primary ml-1" data-toggle="tooltip" data-placement="bottom" title="Tehnika verifikovana" data-fa-transform="shrink-4 down-2"></small>
                                                </h6>
                                                @if (technique.FromDate.HasValue && !string.IsNullOrWhiteSpace(technique.City) && !string.IsNullOrWhiteSpace(technique.Country))
                                                {
                                                    if (technique.Present)
                                                    {
                                                        <p class="text-muted mt-2 mb-0">
                                                            @dateHelper.DateStringFromDateTime(technique.FromDate.Value) - danas
                                                            &bull;
                                                            @((dateHelper.ConvertDateTimeFromUtcToLocal(DateTime.UtcNow) - technique.FromDate.Value).Days) dana
                                                        </p>
                                                    }
                                                    else if (technique.ToDate.HasValue)
