                                                        <p class="text-muted mt-2 mb-0">
                                                            @dateHelper.DateStringFromDateTime(technique.FromDate.Value)
                                                            -
                                                            @dateHelper.DateStringFromDateTime(technique.ToDate.Value)
                                                            &bull;
                                                            @((technique.ToDate.Value - technique.FromDate.Value).Days) dana
                                                        </p>
                                                    }
                                                    <p class="text-muted mb-0">@technique.City @technique.Country</p>
