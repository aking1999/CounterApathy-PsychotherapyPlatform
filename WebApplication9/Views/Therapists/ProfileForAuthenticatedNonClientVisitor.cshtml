                                            <h6 class="fs-0 mb-0">
                                                Nema specijalnost
                                            </h6>
                                            <p class="text-1000 mb-0">Psihoterapeut nije dodao specijalnost.</p>
                                            <hr class="border-dashed border-bottom-0" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="pill-tab-reviews" class="tab-pane fade" role="tabpanel" aria-labelledby="reviews-tab">
                @if (Model.ClientReviews != null && Model.ClientReviews.Any())
                {
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-12 col-sm-6">
                                            Prosečna ocena: @await Html.TryPartialAsync("~/Views/Shared/_RenderStars.cshtml", Model.Rating)
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            Ocenjen: @Model.ClientReviews.Count puta
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @await Html.TryPartialAsync("~/Views/Shared/_ClientsReviews.cshtml", Model.ClientReviews)
            </div>
            <div id="pill-tab-blog" class="tab-pane fade" role="tabpanel" aria-labelledby="blog-tab">
                <div class="alert alert-pink text-center mb-0" role="alert">
                    <i class="far fa-bullhorn mr-2"></i>Mogućnost pisanja blogova biće dodata uskoro.
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.TryPartialAsync("_BookSessionModalForAuthenticatedNonClientVisitor", Model)

@section Scripts {
    @if (Model.HasUpcomingConsultation)
    {
        <script async>
            var getConsultationsUrl = '@Url.Action("GetConsultations", "Consultations", new { Area = "" })';
        </script>
        <script async src="~/js/free-consultations-setup.js"></script>
    }
    <script async src="~/js/accordion-setup.js"></script>
    <script async>
        $(document).ready(function () {
            function ShowCalendarTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-sessions-tab').addClass('active');
                $('#pill-tab-sessions').addClass('show active');

                $('html, body').animate({
                    scrollTop: $("#pill-tab-sessions").offset().top
                }, 2000);
            };

            function ShowSkillsTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-skills-tab').addClass('active');
                $('#pill-tab-skills').addClass('show active');

                $('html, body').animate({
                    scrollTop: $('#pill-tab-skills').offset().top
                }, 1000)
            }

            function ShowReviewsTab() {
                $('#pill-myTab').find('.active').removeClass('active');
                $('#pill-myTabContent').find('.active').removeClass('active');
                $('#pill-reviews-tab').addClass('active');
                $('#pill-tab-reviews').addClass('show active');

                $('html, body').animate({
                    scrollTop: $('#pill-tab-reviews').offset().top
                }, 1000)
            }

            if (sessionStorage.getItem('showCalendarTab') === 'true') {
                sessionStorage.removeItem('showCalendarTab');
                ShowCalendarTab();
            }

            if (sessionStorage.getItem('showSkillsTab') === 'true') {
                sessionStorage.removeItem('showSkillsTab');
                ShowSkillsTab();
            }

            $('#main-btn-book-session').click(function () {
                ShowCalendarTab();
            });
        });
    </script>
}

