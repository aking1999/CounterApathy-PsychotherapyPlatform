@model WebApplication9.ViewModels.ChangePasswordViewModel
@using Framework.Helpers.ExtensionMethods
@{ 
    ViewData.SetTitle("Promena lozinke");
    ViewData.SetMetaDescription("Ažurirajte lozinku popunjavanjem formulara.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.TryPartialAsync("~/Views/Shared/Widgets/_NavCard.cshtml",
    new WebApplication9.WidgetViewModels.NavCardWidgetViewModel("fal fa-lock fa-sm",
        "text-primary",
        ViewData.GetTitle(),
        ViewData.GetMetaDescription()))

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-sm-5 p-4">
                <form id="change-password-form" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="invalid-feedback"></div>
                    <div class="form-group">
                        <label asp-for="OldPassword"></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-lock fa-fw"></i></span>
                            </div>
                            <input asp-for="OldPassword" class="form-control" />
                        </div>
                        <span>
                            <span asp-validation-for="OldPassword" class="invalid-feedback"></span>
                            <br />
                        </span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewPassword"></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-lock fa-fw"></i></span>
                            </div>
                            <input asp-for="NewPassword" class="form-control" />
                        </div>
                        <span>
                            <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
                            <br />
                        </span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fal fa-lock fa-fw"></i></span>
                            </div>
                            <input asp-for="ConfirmPassword" class="form-control" />
                        </div>
                        <span>
                            <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                            <br />
                        </span>
                    </div>
                    <button id="btn-change-password"
                            type="button"
                            class="d-flex ml-auto btn btn-sm btn-primary">
                        <span id="btn-change-password-text" class="m-auto">
                            Ažuriraj
                        </span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            let oldPassword = $('#OldPassword');
            let newPassword = $('#NewPassword');
            let confirmPassword = $('#ConfirmPassword');
            let btnChangePassword = $('#btn-change-password');
            let btnChangePasswordText = $('#btn-change-password-text');
            let btnChangePasswordTextUnchanged = btnChangePasswordText.html();
            let changePasswordForm = $('#change-password-form');

            btnChangePassword.click(function () {
                DisableInputs();
                const width = btnChangePassword.width();
                const height = btnChangePassword.height();
                btnChangePasswordText.fadeOut('fast', function () {
                    $(this).html('<i class="fas fa-spinner fa-spin"></i>').fadeIn('slow');
                    btnChangePassword.width(width);
                    btnChangePassword.height(height);
                })

                setTimeout(function () {
                    if (FormIsValid()) {
                        btnChangePasswordText.fadeOut('fast', function () {
                            $(this).html('<i class="ca-lightgreen fas fa-check no-tick"></i>').fadeIn('slow', function () {
                                setTimeout(function () {
                                    changePasswordForm.submit();
                                }, 600);
                            });
                        })
                    } else HandleError('Popunite sva obavezna polja', '', 'info')
                }, 600)
            })

            function ElementIsValid(element) {
                return changePasswordForm.validate().element($(element));
            }

            function FormIsValid() {
                const oldPasswordValid = ElementIsValid(oldPassword);
                const newPasswordValid = ElementIsValid(newPassword);
                const confirmPasswordValid = ElementIsValid(confirmPassword);

                return (oldPasswordValid && newPasswordValid && confirmPasswordValid);
            }

            function EnableInputs() {
                btnChangePassword.prop('disabled', false);
                oldPassword.prop('readonly', false);
                newPassword.prop('readonly', false);
                confirmPassword.prop('readonly', false);
            }

            function DisableInputs() {
                btnChangePassword.prop('disabled', true);
                oldPassword.prop('readonly', true);
                newPassword.prop('readonly', true);
                confirmPassword.prop('readonly', true);
            }

            function HandleError(title, body, severity) {
                btnChangePasswordText.fadeOut('fast', function () {
                    $(this).html('<i class="text-danger fas fa-times no-tick"></i>').fadeIn('slow');
                    toastr[severity](body, title)
                })
                .promise()
                .done(function () {
                    setTimeout(function () {
                        btnChangePasswordText.fadeOut('fast', function () {
                            $(this).html(btnChangePasswordTextUnchanged).fadeIn('slow');
                            EnableInputs();
                        });
                    }, 600)
                })
            }
        })
    </script>
}