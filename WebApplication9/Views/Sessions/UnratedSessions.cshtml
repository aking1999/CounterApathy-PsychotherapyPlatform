@model List<DataTransferObjects.ViewModels.Client.BookedSessionAddRatingViewModel>
@using Framework.Helpers.ExtensionMethods
@inject Framework.Interfaces.IDateTimeHelper DateHelper
@{
    ViewData.SetTitle("Neocenjene seanse");
    ViewData.SetMetaDescription("Sve Vaše neocenjene seanse.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/star-rating/star-rating.css" />
    <link rel="stylesheet" href="~/sweet-alert2/sweetalert2.min.css" />
}

<h3 class="text-center mb-3">
    Kliknite na dugme <button class="btn btn-sm btn-soft-warning"><i class="far fa-star"></i></button> ispod kako biste ocenili seansu
</h3>

<div class="row no-gutters">
    @if (Model != null && Model.Any())
    {
        <div class="col-12">
            @foreach (var bookedSession in Model)
            {
                <div class="row justify-content-center no-gutters">
                    <div class="col-12 col-sm-8 col-md-7 col-lg-5 col-xl-4">
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="media">
                                    <div class="avatar avatar-3xl mr-3">
                                        <img src="@bookedSession.ProfilePhoto" class="rounded-circle d-inline-flex" alt="psihoterapeut @bookedSession.TherapistFirstName @bookedSession.TherapistLastName" />
                                    </div>
                                    <div class="media-body">
                                        <p class="mb-2 text-700">@bookedSession.TherapistFirstName @bookedSession.TherapistLastName</p>
                                        @if (bookedSession.Type == 0)
                                        {
                                            <p class="mb-2 text-muted fs--1">Individualna seansa</p>
                                        }
                                        else
                                        {
                                            <p class="mb-2 text-muted fs--1">Grupna seansa</p>
                                        }
                                        <p class="mb-2 text-muted fs--1">@DateHelper.ConvertDateTimeFromUtcToLocalString(bookedSession.StartTime)h - @DateHelper.ConvertDateTimeFromUtcToLocalString(bookedSession.EndTime)</p>
                                        <div id="session-stars-holder-@bookedSession.BookingId">
                                            @await Html.TryPartialAsync("~/Views/Shared/_RenderRateSessionButton.cshtml", bookedSession)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="row justify-content-center no-gutters mb-3">
                <div class="col-12 col-sm-8 col-md-7 col-lg-5 col-xl-4">
                    <button id="btn-unreviewed-sessions-done" type="button" class="btn btn-falcon-primary btn-block">
                        <span id="btn-unreviewed-sessions-done-text">
                            &nbsp;<i class="fas fa-check-circle text-success mr-2"></i>Gotovo&nbsp;
                        </span>
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-12 text-center px-4 mb-3 text-secondary">
            Trenutno nemate nijednu završenu neocenjenu seansu.
            <br />
            <strong>Sve Vaše završene neocenjene seanse biće prikazane ovde.</strong>
            <br />
            Kliknite na dugme ispod kako biste pogledali sve svoje seanse.
        </div>
        <div class="col-12 text-center mb-3">
            <a href="@Url.AllBookedSessionsUrl()"
               class="btn btn-sm btn-success">
                <i class="far fa-calendar-check mr-2"></i>Pogledajte zakazane seanse
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script async src="~/sweet-alert2/sweetalert2.all.min.js"></script>
    <script async>
        $(document).ready(function () {
            $('#container-main main').removeClass('pb-3');

            const btnDone = $('#btn-unreviewed-sessions-done');
            const btnDoneText = btnDone.find('#btn-unreviewed-sessions-done-text');
            const btnDoneTextUnchanged = btnDoneText.html();

            btnDone.click(function () {
                btnDone.prop('disabled', true);
                let width = btnDone.width();
                let height = btnDone.height();
                btnDoneText.fadeOut('fast', function () {
                    $(this).html('<i class="fas fa-spinner fa-spin no-tick"></i>').fadeIn('slow');
                    btnDone.width(width);
                    btnDone.height(height);
                });

                setTimeout(function () {
                    if ($('div[id^="session-modal-holder-"]').length) {
                        btnDoneText.fadeOut('fast', function () {
                            $(this).html('<i class="text-danger fas fa-times no-tick"></i>').fadeIn('slow');
                            toastr['info']('', 'Molimo ocenite sve seanse');
                        })
                            .promise()
                            .done(function () {
                                setTimeout(function () {
                                    btnDoneText.fadeOut('fast', function () {
                                        $(this).html(btnDoneTextUnchanged).fadeIn('slow');
                                        btnDone.prop('disabled', false);
                                    });
                                }, 1300)
                            })
                    } else {
                        btnDoneText.fadeOut('fast', function () {
                            $(this).html('<i class="text-success fas fa-check no-tick"></i>').fadeIn('slow');
                        })
                            .promise()
                            .done(function () {
                                setTimeout(function () {
                                    btnDone.prop('disabled', false);
                                    Swal.fire({
                                        title: "Hvala Vam što ste ocenili sve seanse!",
                                        icon: "success",
                                        confirmButtonColor: "#00d27a",
                                        confirmButtonText: "U redu"
                                    }).then(() => {
                                        window.location.href = '@Url.Action("BookedSessions", "Sessions", new { Area = "" })'
                                    });
                                }, 700);
                            })
                    }
                }, 600)
            })
        })
    </script>
}

