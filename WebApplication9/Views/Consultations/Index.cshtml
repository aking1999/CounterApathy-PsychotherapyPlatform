<section class="pt-1 pb-0">
    <h2 class="text-center text-800">Psihoterapeuti koji nude besplatne konsultacije</h2>
    <div class="heading-underline"></div>
    <div class="container container-fluid">
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var therapist in Model)
                {
                    <div class="col-6 col-sm-4 col-md-3 mb-3">
                        <div class="card h-100 card-span">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="card-img-top d-flex justify-content-start">
                                    <div class="avatar avatar-2xl mr-2">
                                        <img style="border: 2px solid white !important; min-width: 2.5rem !important;"
                                             class="rounded-circle"
                                             src="~/images/user-images/@therapist.ProfilePhotoPath"
                                             alt="Psihoterapeut @therapist.FirstName @therapist.LastName"
                                             loading="lazy" />
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <h6 class="mb-0">
                                            <a class="text-1000" href="@Url.PsychotherapistPublicProfileUrlWithName(therapist.Id, therapist.FirstName, therapist.LastName)">
                                                @therapist.FirstName @therapist.LastName
                                            </a>
                                            <i data-toggle="tooltip"
                                               data-placement="bottom"
                                               title="Psihoterapeut verifikovan"
                                               class='fas fa-badge-check text-primary ml-1 position-absolute'
                                               style="margin-top: 0.1rem !important;">
                                            </i>
                                        </h6>
                                    </div>
                                </div>
                                <button data-therapist-id="@therapist.Id"
                                        class="btn-therapist-free-consultations btn btn-sm btn-soft-primary ml-0 ml-md-0 ml-xl-5 mt-2 mt-xl-0"
                                        type="button"
                                        style="opacity: 1 !important;">
                                    <span class="btn-therapist-free-consultations-text">Zakaži konsultacije</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>trenutno nema bla bla pogledajte psihoterapeute</p>
        }
    </div>
</section>

@section Scripts {
    @if (Model != null && Model.Any())
    {
        <script async>
            var getConsultationsUrl = '@Url.Action("GetConsultations", "Consultations", new { Area = "" })';
        </script>
        <script async src="~/js/free-consultations-setup.js"></script>
        <script async>
            $(document).ready(function () {
                $('main').removeClass('pb-3');
            })
        </script>
    }
    <script async>
        $(document).ready(function () {
            $('#home-section').removeClass('px-2 px-lg-0');
            $('#container-main').removeClass('container');
            $('#container-main').addClass('px-2 px-lg-0');
            $('#footer').addClass('px-2 px-lg-0');

            $('#btn-free-consultation-learn-more').click(function () {
                $('html, body').animate({
                    scrollTop: $("#free-consultation-services").offset().top
                }, 1000);
            })
        })
    </script>
}

