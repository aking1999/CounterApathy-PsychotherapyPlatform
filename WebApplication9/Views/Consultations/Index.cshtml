                <h2 class="fs-1 mt-4 mb-2-5rem">
                    Zakažite besplatne konsultacije sa psihoterapeutom.
                </h2>
                <button id="btn-free-consultation-learn-more" class="btn btn-primary mb-2 mb-sm-0 mb-md-2 mb-lg-0 rounded-pill scrollto">
                    Saznajte više
                </button>
            </div>
            <div class="col-12 col-md-6 align-self-center">
                <div class="avatar">
                    <img src="~/custom-site-layout/images/psychotherapy-session.png" alt="psihoterapijska seansa" />
                </div>
            </div>
        </div>
    </div>
</section>
