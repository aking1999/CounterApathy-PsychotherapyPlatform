@using Framework.Helpers.ExtensionMethods

@{
    ViewData.SetTitle("Uputstvo za pristup Google Meet seansi putem računara");
    ViewData.SetMetaDescription("Saznajte kako da u samo 3 koraka, putem računara pristupite psihoterapijskoj " +
        "seansi na Google Meetu.");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section StyleSheets {
    <link rel="stylesheet" href="~/css/booking-roadmap.css" />
    <link rel="stylesheet" href="~/custom-site-layout/vendor/lightbox/css/lightbox.min.css" />
}

<h2 class="text-center my-5 mx-3">Kako da putem računara pristupim seansi na Google Meetu?</h2>
<div class="booking-timeline">
    <div class="timeline__event  animated fadeInUp timeline__event--type2">
        <div class="timeline__event__icon">
            <i class="far fa-envelope"></i>
        </div>
        <div class="timeline__event__step">
            Korak 1.
        </div>
        <div class="timeline__event__content ">
            <div class="timeline__event__title">
                Otvorite imejl sa linkom za pristup seansi
            </div>
            <br />
            <div class="timeline__event__description">
                <p>
                    Najkasnije 4 sata pre početka zakazane seanse, stići će Vam imejl sa linkom za pristup Google Meet seansi.
                    <br>
                    Slika imejla je prikazan ispod (kliknite na sliku da je uvećate):
                </p>
                <a href="~/images/content-images/join-session/session-invite-link-email.png"
                   data-lightbox="join-google-meet-session-by-computer"
                   data-title="Imejl sa linkom za pristup Google Meet seansi"
                   class="avatar">
                    <img class="border border-primary d-inline-block"
                         src="~/images/content-images/join-session/session-invite-link-email.png"
                         alt="imejl sa linkom za pristup Google Meet seansi" />
                </a>
                <p class="mb-0 mt-3">
                    <span class="fa-stack">
                        <i class="fa fa-circle fa-stack-2x" style="color: #ffffd6 !important;"></i>
                        <i class="far fa-star fa-stack-1x text-warning"></i>
                    </span>
                    Ako ste zakazali grupnu Google Meet seansu, svim članovima prosledite link za pristup.
                </p>
            </div>
        </div>
    </div>
    <div class="timeline__event animated fadeInUp timeline__event--type2">
        <div class="timeline__event__icon">
            <i class="far fa-link"></i>
        </div>
        <div class="timeline__event__step">
            Korak 2.
        </div>
        <div class="timeline__event__content">
            <div class="timeline__event__title">
                Priključite mikrofon za računar i kliknite na link za pristup
            </div>
            <br />
            <div class="timeline__event__description">
                <p>
                    Priključite mikrofon za računar i klikom na link za pristup, otvoriće se nova stranica koja Vas preusmerava na sajt Google Meet,
                    tu je potrebno da dozvolite upotrebu Vašeg mikrofona.
                    <br>
                    Slika stranice je prikazana ispod (kliknite na sliku da je uvećate):
                </p>
                <a href="~/images/content-images/join-session/join-google-meet-by-computer.png"
                   data-lightbox="join-google-meet-session-by-computer"
                   data-title="Dozvolite mikrofon na stranici na kojoj se održava seansa"
                   class="avatar">
                    <img class="border border-primary d-inline-block"
                         src="~/images/content-images/join-session/join-google-meet-by-computer.png"
                         alt="dozvolite mikrofon na stranici na kojoj se održava seansa" />
                </a>
            </div>
        </div>
    </div>
    <div class="timeline__event animated fadeInUp timeline__event--type3">
        <div class="timeline__event__icon">
            <i class="far fa-check"></i>
        </div>
        <div class="timeline__event__step">
            Korak 3.
        </div>
        <div class="timeline__event__content">
            <div class="timeline__event__title">
                Pristupite seansi sa terapeutom
            </div>
            <br />
            <div class="timeline__event__description">
                <p>
                    Kliknite na dugme "Ask to join" da biste pristupili seansi. Ubrzo nakon klika, terapeut će prihvatiti Vaš zahtev za pristup.
                    <br>
                    Slika dugmeta je prikazana ispod (kliknite na sliku da je uvećate):
                </p>
                <a href="~/images/content-images/join-session/ask-to-join-session.png"
                   data-lightbox="join-google-meet-session-by-computer"
                   data-title="Kliknite na dugme 'Ask to join'"
                   class="avatar">
                    <img class="border border-primary d-inline-block"
                         src="~/images/content-images/join-session/ask-to-join-session.png"
                         alt="kliknite na dugme 'Ask to join'" />
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom-site-layout/vendor/lightbox/js/lightbox.min.js"></script>
}